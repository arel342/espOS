static void drawLogo(float p) {
  float a = easeOut(p * 2.4f);
  uint8_t al = (uint8_t)(255 * a);
  float hS = 46.0f * easeOut(p * 1.7f);
  float wT = 40.0f * easeOut(p * 1.6f - 0.15f);
  float wM = 22.0f * easeOut(p * 1.6f - 0.30f);
  float wB = 45.0f * easeOut(p * 1.6f - 0.45f);
  float sq = easeOut(p * 3.0f - 1.9f);
  if (wB > 1) rrect(96, 132, wB, 10, 3.5f, H(0x8F8CF6), al);
  if (hS > 1) rrect(96, 96, 11.5f, hS, 3.5f, H(0x6CF0D2), al);
  if (wT > 1) rrect(96, 96, wT, 10, 3.5f, H(0x6CF0D2), al);
  if (wM > 1) rrect(108, 114, wM, 10, 3.5f, H(0xBDF8EA), al);
  if (sq > 0.02f) { float s = 11.0f * sq; rrect(137.5f + (11 - s) / 2, 96 + (11 - s) / 2, s, s, 3.2f, H(0x8F8CF6), (uint8_t)(255 * sq)); }
}

static void renderBoot(uint32_t t) {
  fillSolid(BOOT_BG);
  glow(120, 118, 125, H(0x0B343C), 60);
  float pl = t / 1000.0f;
  static const int8_t SPX[6][2] = {{-62,-30},{-30,-62},{22,-54},{36,-4},{-48,28},{4,34}};
  float sf = 1.0f - smooth((t - 350) / 1100.0f);
  if (sf > 0) for (int i = 0; i < 6; i++) {
    float tw = 0.5f + 0.5f * sinf(t * 0.012f + i * 1.7f);
    disc(120 + SPX[i][0], 119 + SPX[i][1], 1.5f, H(0x7FF5DC), (uint8_t)(200 * sf * tw));
  }
  drawLogo(pl > 1 ? 1 : pl);
  float ta = smooth((t - 700) / 450.0f);
  if (ta > 0) {
    int tw = textWidth(B29, "espOS"), x = 120 - tw / 2;
    int yy = 190 - (int)((1 - ta) * 5);
    int w1 = drawText(B29, x, yy, "esp", COL_WHITE, (uint8_t)(255 * ta));
    drawText(B29, x + w1, yy, "OS", H(0x6CF0D2), (uint8_t)(255 * ta));
  }
  float fa = smooth((t - 1300) / 400.0f);
  if (fa > 0) {
    float prog = smooth((t - 1500) / 3000.0f);
    rrect(66, 247, 108, 3, 1.5f, H(0x121C27), (uint8_t)(255 * fa));
    if (prog > 0.01f) rrect(66, 247, 108 * prog, 3, 1.5f, prog >= 1.0f ? H(0x3FAE93) : H(0x6CF0D2), (uint8_t)(255 * fa));
    drawText(F8, 120, 269, prog >= 1.0f ? "Siap." : "Menyiapkan espOS", COL_MUTED, (uint8_t)(255 * fa), 1);
    drawText(F7, 120, 305, "DIBUAT OLEH FAREL", H(0x5D6676), (uint8_t)(255 * fa), 1);
  }
}

static void bootSequence() {
  const uint32_t BOOT_MS = 5000;
  uint32_t t0 = millis();
  bool first = true;
  for (;;) {
    uint32_t t = millis() - t0; if (t > BOOT_MS) t = BOOT_MS;
    renderBoot(t); pushFrame();
    if (first) { fadeBacklight(0, blLevel, 350); first = false; }
    if (t >= BOOT_MS) break;
  }
  if (snapBuf) memcpy(snapBuf, fb, FB_BYTES);
  uint32_t f0 = millis();
  for (;;) {
    uint32_t dt = millis() - f0; if (dt > 520) break;
    float a = smooth(dt / 520.0f);
    drawScene();
    if (snapBuf) { uint8_t al = (uint8_t)(255 * a); for (int i = 0; i < SCR_W * SCR_H; i++) fb[i] = mix(fb[i], snapBuf[i], al); }
    else { uint8_t da = (uint8_t)(255 * (1 - a)); for (int i = 0; i < SCR_W * SCR_H; i++) fb[i] = mix(0x0000, fb[i], da); }
    pushFrame();
  }
}

// ============================== TOUCH XPT2046 ================================
static int calX0 = TOUCH_X_MIN, calX1 = TOUCH_X_MAX, calY0 = TOUCH_Y_MIN, calY1 = TOUCH_Y_MAX, calSwap = TOUCH_SWAP_XY;
static bool calOK = false;

static uint16_t tsXfer(uint8_t cmd) {
  tftSPI.beginTransaction(SPISettings(1000000, MSBFIRST, SPI_MODE0));
  digitalWrite(PIN_TS_CS, LOW);
  tftSPI.transfer(cmd);
  uint16_t v = tftSPI.transfer16(0);
  digitalWrite(PIN_TS_CS, HIGH);
  tftSPI.endTransaction();
  return v >> 3;
}
static void sort5(int* a) { for (int i = 1; i < 5; i++) { int k = a[i], j = i - 1; while (j >= 0 && a[j] > k) { a[j + 1] = a[j]; j--; } a[j + 1] = k; } }

// nilai mentah (median 5 sampel). false = tidak disentuh / sinyal terlalu berisik
static bool tsRaw(int& rx, int& ry) {
  int z1 = tsXfer(0xB1), z2 = tsXfer(0xC1);
  if (z1 + 4095 - z2 < TOUCH_Z_MIN) return false;
  int xs[5], ys[5];
  tsXfer(0xD1);
  for (int i = 0; i < 5; i++) { xs[i] = tsXfer(0xD1); ys[i] = tsXfer(0x91); }
  tsXfer(0x90);
  sort5(xs); sort5(ys);
  if (xs[4] - xs[0] > 350 || ys[4] - ys[0] > 350) return false;
  rx = (xs[1] + xs[2] + xs[3]) / 3; ry = (ys[1] + ys[2] + ys[3]) / 3;
#if TOUCH_DEBUG
  Serial.printf("touch raw x=%d y=%d\n", rx, ry);
#endif
  return true;
}
static bool tsRead(int& sx, int& sy) {
  int rx, ry; if (!tsRaw(rx, ry)) return false;
  int ax = calSwap ? ry : rx, ay = calSwap ? rx : ry;
  long mx = (long)(ax - calX0) * (SCR_W - 1) / (calX1 - calX0);
  long my = (long)(ay - calY0) * (SCR_H - 1) / (calY1 - calY0);
  if (mx < 0) mx = 0; if (mx > SCR_W - 1) mx = SCR_W - 1;
  if (my < 0) my = 0; if (my > SCR_H - 1) my = SCR_H - 1;
  sx = (int)mx; sy = (int)my;
  return true;
}

// tunggu sentuhan, rata-ratakan, tunggu lepas
static void waitTouchRaw(int& rx, int& ry) {
  for (;;) {
    int a, b;
    if (tsRaw(a, b)) {
      long sx = 0, sy = 0; int n = 0; uint32_t t0 = millis();
      while (millis() - t0 < 450) { int c, d; if (tsRaw(c, d)) { sx += c; sy += d; n++; } delay(6); }
      if (n < 6) continue;
      rx = sx / n; ry = sy / n;
      int miss = 0; while (miss < 6) { int c, d; if (tsRaw(c, d)) miss = 0; else miss++; delay(10); }
      return;
    }
    delay(10);
  }
}
static void drawCross(int x, int y, u16 c) {
  rrect(x - 13, y - 0.75f, 26, 1.5f, 0.75f, c);
  rrect(x - 0.75f, y - 13, 1.5f, 26, 0.75f, c);
  ringS(x, y, 8, 1.5f, c);
}
static void calibrate() {
  static const int TX[4] = {20, 219, 20, 219};
  static const int TY[4] = {20, 20, 299, 299};
  int rx[4], ry[4];
  for (int i = 0; i < 4; i++) {
    fillSolid(BOOT_BG);
    drawText(B13, 120, 120, "Kalibrasi touch", COL_TEXT, 255, 1);
    drawText(F9, 120, 142, "Sentuh titik + dengan ujung jari", COL_MUTED, 255, 1);
    char b[16]; snprintf(b, sizeof(b), "%d / 4", i + 1);
    drawText(F9, 120, 164, b, THEMES[curTheme].accent, 255, 1);
    drawCross(TX[i], TY[i], THEMES[curTheme].accent);
    pushFrame();
    waitTouchRaw(rx[i], ry[i]);
  }
  // sumbu mana yang berubah ke arah horizontal layar?
  int dX = abs(rx[1] - rx[0]) + abs(rx[3] - rx[2]), dY = abs(ry[1] - ry[0]) + abs(ry[3] - ry[2]);
  int sw = dY > dX ? 1 : 0;
  int ax[4], ay[4];
  for (int i = 0; i < 4; i++) { ax[i] = sw ? ry[i] : rx[i]; ay[i] = sw ? rx[i] : ry[i]; }
  float axl = (ax[0] + ax[2]) / 2.0f, axr = (ax[1] + ax[3]) / 2.0f;     // sumbu X di layar x=20 dan x=219
  float ayt = (ay[0] + ay[1]) / 2.0f, ayb = (ay[2] + ay[3]) / 2.0f;     // sumbu Y di layar y=20 dan y=299
  float sx = (axr - axl) / 199.0f, sy = (ayb - ayt) / 279.0f;
  int nx0 = (int)(axl - sx * 20), nx1 = (int)(axl + sx * 219);
  int ny0 = (int)(ayt - sy * 20), ny1 = (int)(ayt + sy * 299);
  bool good = abs(nx1 - nx0) > 800 && abs(ny1 - ny0) > 800;
  fillSolid(BOOT_BG);
  if (good) {
    calX0 = nx0; calX1 = nx1; calY0 = ny0; calY1 = ny1; calSwap = sw; calOK = true;
    prefs.putInt("cx0", calX0); prefs.putInt("cx1", calX1); prefs.putInt("cy0", calY0); prefs.putInt("cy1", calY1);
    prefs.putUChar("csw", (uint8_t)calSwap); prefs.putUChar("cok", 1);
    drawText(B13, 120, 150, "Kalibrasi berhasil", THEMES[curTheme].accent, 255, 1);
  } else {
    drawText(B13, 120, 140, "Kalibrasi gagal", H(0xFF8A80), 255, 1);
    drawText(F9, 120, 162, "Ulangi dari Setelan > Kalibrasi", COL_MUTED, 255, 1);
  }
  pushFrame(); delay(900);
}

