static void ledWrite(uint8_t r, uint8_t g, uint8_t b) { neopixelWrite(PIN_FLASH_LED, r, g, b); }
static void flashApply() {
  if (!flashOn) { ledWrite(0, 0, 0); return; }
  ledWrite((uint8_t)((FL_RGB[flashIdx][0] * FLASH_LEVEL) / 255),
           (uint8_t)((FL_RGB[flashIdx][1] * FLASH_LEVEL) / 255),
           (uint8_t)((FL_RGB[flashIdx][2] * FLASH_LEVEL) / 255));
}
static void flashToggle() {                              // ketuk: putih <-> mati
  if (flashOn) flashOn = false; else { flashOn = true; flashIdx = 0; }
  flashApply(); dirty = true;
}
static void flashPick(int idx) { flashIdx = (uint8_t)idx; flashOn = true; flashApply(); dirty = true; }

static void setToast(const char* m) { strncpy(wfToast, m, sizeof(wfToast) - 1); wfToast[sizeof(wfToast) - 1] = 0; wfToastUntil = millis() + 3000UL; dirty = true; }
static void setPwMsg(const char* m, bool err) { strncpy(pwMsg, m, sizeof(pwMsg) - 1); pwMsg[sizeof(pwMsg) - 1] = 0; pwMsgErr = err; pwMsgUntil = millis() + 4000UL; dirty = true; }
static void pwWipe() { memset(pwBuf, 0, sizeof(pwBuf)); pwLen = 0; pwShow = false; pwMsg[0] = 0; kbL = 0; }
static void wifiScanAbort() {
  if (wfScanRunning) { esp_wifi_scan_stop(); WiFi.scanDelete(); wfScanRunning = false; }
}

static void wifiStart() {
  dirty = true;
  WiFi.mode(WIFI_STA);                                   // radio hidup (juga dibutuhkan untuk memindai)
  if (!wifiSsid[0]) { wifiSt = WF_FAIL; wifiT0 = millis(); return; }
  WiFi.setAutoReconnect(true);
  WiFi.begin(wifiSsid, wifiPass);
  wifiSt = WF_CONNECTING; wifiT0 = millis();
}
static void wifiStop() {
  wfScanRunning = false; wfCount = 0; pendSave = false; memset(pendPass, 0, sizeof(pendPass));
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  wifiSt = WF_OFF; ntpPending = false; dirty = true;
}
static void wifiToggle() {
  wifiWant = !wifiWant;
  prefs.putUChar("wifi", wifiWant ? 1 : 0);
  if (wifiWant) { wfScanT0 = millis() - WIFI_SCAN_MS; wifiStart(); } else wifiStop();
}
// sambung ke jaringan pilihan pengguna; kredensial disimpan HANYA jika berhasil tersambung
static void wifiConnectTo(const char* ssid, const char* pass) {
  strncpy(pendSsid, ssid, 32); pendSsid[32] = 0;
  strncpy(pendPass, pass, 63); pendPass[63] = 0;
  pendSave = true;
  wifiScanAbort();
  wifiWant = true; prefs.putUChar("wifi", 1);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(false);                          // agar password salah terdeteksi cepat
  WiFi.disconnect(false);
  WiFi.begin(pendSsid, pendPass);
  wifiSt = WF_CONNECTING; wifiT0 = millis(); ntpPending = false; dirty = true;
}

// ambil waktu dari jam sistem (diisi NTP) -> jam espOS
static bool syncFromSystem() {
  struct tm ti;
  if (!getLocalTime(&ti, 0) || ti.tm_year < 120) return false;      // belum tersinkron
  clk_hh = ti.tm_hour; clk_mm = ti.tm_min; clk_wd = ti.tm_wday;
  clk_dd = ti.tm_mday; clk_mo = ti.tm_mon; clk_yy = ti.tm_year + 1900;
  lastMinuteMs = millis() - (uint32_t)ti.tm_sec * 1000UL;           // menit berganti tepat pada detik ke-0
  timeSynced = true; ntpLastMs = millis(); dirty = true;
  return true;
}

static void wifiTask(uint32_t now) {
  static uint32_t last = 0;
  if (now - last < 300) return;
  last = now;
  switch (wifiSt) {
    case WF_CONNECTING: {
      wl_status_t st = WiFi.status();
      if (st == WL_CONNECTED) {
        wifiSt = WF_ON; ntpPending = true; dirty = true;
        WiFi.setAutoReconnect(true);
        configTzTime(NTP_TZ, "pool.ntp.org", "time.google.com", "id.pool.ntp.org");
        Serial.printf("Wi-Fi terhubung, sinkron NTP (WIB). RAM bebas: %u KB\n", (unsigned)(ESP.getFreeHeap() / 1024));
        if (pendSave) {                                   // simpan jaringan + password ke flash
          strncpy(wifiSsid, pendSsid, 32); wifiSsid[32] = 0;
          strncpy(wifiPass, pendPass, 63); wifiPass[63] = 0;
          prefs.putString("wssid", wifiSsid); prefs.putString("wpass", wifiPass);
          pendSave = false; memset(pendPass, 0, sizeof(pendPass));
          setToast("Tersambung");
          if (screen == SC_WIFIPASS) { pwWipe(); goScreen(SC_WIFI); }
        }
      } else if (now - wifiT0 > (pendSave ? 15000UL : 20000UL) ||
                 (pendSave && now - wifiT0 > 4000UL && (st == WL_CONNECT_FAILED || st == WL_NO_SSID_AVAIL))) {
        wifiSt = WF_FAIL; wifiT0 = now; WiFi.disconnect(false); dirty = true;
        if (pendSave) {
          pendSave = false; memset(pendPass, 0, sizeof(pendPass));
          if (screen == SC_WIFIPASS) setPwMsg("Gagal tersambung. Cek password.", true);
          else setToast("Gagal tersambung");
        }
      }
      break;
    }
    case WF_ON:
      if (WiFi.status() != WL_CONNECTED) { wifiSt = WF_CONNECTING; wifiT0 = now; dirty = true; }
      else if (ntpPending) { if (syncFromSystem()) { ntpPending = false; Serial.println("Waktu tersinkron dari NTP"); } }
      else if (now - ntpLastMs > 3600000UL) ntpPending = true;      // sinkron ulang tiap 1 jam
      break;
    case WF_FAIL:
      if (wifiWant && wifiSsid[0] && now - wifiT0 > 60000UL) wifiStart();   // coba lagi tiap 1 menit
      break;
    default: break;
  }
}

// urutan daftar: yang tersambung dulu, lalu sinyal terkuat (per level bar), lalu nama
static bool wfBefore(const WfNet& a, const WfNet& b) {
  bool ca = wfIsCur(a.ssid), cb = wfIsCur(b.ssid);
  if (ca != cb) return ca;
  int la = wfBars(a.rssi), lb = wfBars(b.rssi);
  if (la != lb) return la > lb;
  return strcmp(a.ssid, b.ssid) < 0;
}
static void wfCollect(int n) {
  WfNet tmp[16]; int c = 0;
  for (int i = 0; i < n && c < 16; i++) {
    String sd = WiFi.SSID(i);
    if (sd.length() == 0 || sd.length() > 32) continue;       // lewati SSID tersembunyi
    int8_t r = (int8_t)WiFi.RSSI(i);
    bool dup = false;
    for (int j = 0; j < c; j++) if (!strcmp(tmp[j].ssid, sd.c_str())) { if (r > tmp[j].rssi) tmp[j].rssi = r; dup = true; break; }
    if (dup) continue;
    strncpy(tmp[c].ssid, sd.c_str(), 32); tmp[c].ssid[32] = 0;
    tmp[c].rssi = r; tmp[c].secure = (WiFi.encryptionType(i) != WIFI_AUTH_OPEN) ? 1 : 0;
    c++;
  }
  for (int i = 1; i < c; i++) {
    WfNet k = tmp[i]; int j = i - 1;
    while (j >= 0 && wfBefore(k, tmp[j])) { tmp[j + 1] = tmp[j]; j--; }
    tmp[j + 1] = k;
  }
  bool ch = (c != wfCount);
  for (int i = 0; !ch && i < c; i++)
    if (strcmp(tmp[i].ssid, wfNet[i].ssid) || tmp[i].secure != wfNet[i].secure || wfBars(tmp[i].rssi) != wfBars(wfNet[i].rssi)) ch = true;
  for (int i = 0; i < c; i++) wfNet[i] = tmp[i];
  wfCount = c;
  if (ch) dirty = true;
}
// pemindaian asinkron, dimulai ulang tiap WIFI_SCAN_MS selama layar Wi-Fi terbuka
static void wifiScanTask(uint32_t now) {
  if (screen != SC_WIFI || locked || !wifiWant || wifiSt == WF_OFF || wifiSt == WF_CONNECTING) return;
  if (wfScanRunning) {
    int n = WiFi.scanComplete();
    if (n == WIFI_SCAN_RUNNING) { if (now - wfScanT0 > 6000UL) { wifiScanAbort(); } return; }
    if (n >= 0) wfCollect(n);
    WiFi.scanDelete(); wfScanRunning = false; dirty = true;
  }
  if (now - wfScanT0 >= WIFI_SCAN_MS) {
    wfScanT0 = now;
    wfScanRunning = (WiFi.scanNetworks(true, false, false, 110) == WIFI_SCAN_RUNNING);
    dirty = true;
  }
}

static void closePanelNow() { cpOpen = false; cpDrag = false; cpAnim = 0; cpV = 0; cpMode = 0; cpPress = -1; cpHold = 0; trActive = false; lockSpring = false; }

// Tidur: layar mati, Wi-Fi & LED mati, CPU light-sleep. Sentuh layar untuk bangun (kembali ke lock screen).
static void goSleep() {
  if (ota::busy) { setToast("Tunggu proses update"); return; }
  closePanelNow();
  flashOn = false; ledWrite(0, 0, 0);
  wifiStop();
  locked = true; lockShift = 0; lockAuth = false; credReset();
  fadeBacklight(blLevel, 0, 250);
  sleeping = true;
}

// Deep sleep: hampir semua mati. Bangun dengan tombol BOOT (GPIO0) atau RESET -> espOS booting ulang.
static void enterDeepSleep() {
  if (ota::busy) { setToast("Tunggu proses update"); return; }
  waitPush();
  closePanelNow();
  flashOn = false; ledWrite(0, 0, 0);
  wifiStop();
  fadeBacklight(blLevel, 0, 250);
  tft.sendCommand(0x28);                                 // display off
  tft.sendCommand(0x10);                                 // sleep in
  delay(10);
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcDetach(PIN_TFT_BL);
#else
  ledcDetachPin(PIN_TFT_BL);
#endif
  pinMode(PIN_TFT_BL, OUTPUT); digitalWrite(PIN_TFT_BL, LOW);
  gpio_hold_en((gpio_num_t)PIN_TFT_BL);                  // jaga backlight tetap mati selama deep sleep
  gpio_deep_sleep_hold_en();
  esp_sleep_enable_ext0_wakeup((gpio_num_t)PIN_WAKE, 0);
  rtc_gpio_pullup_en((gpio_num_t)PIN_WAKE);
  rtc_gpio_pulldown_dis((gpio_num_t)PIN_WAKE);
  Serial.println("Deep sleep...");
  Serial.flush();
  esp_deep_sleep_start();
}

static void closeSheet() { sheetOpen = false; lastAnimMs = millis(); dirty = true; }
static void applyTheme(int i) {
  if (i == curTheme) return;
  curTheme = i; bgTheme = -1; prefs.putUChar("tema", (uint8_t)i); buildButtons(); dirty = true;
}
static void wake() {
  sleeping = false; dirty = true;
  if (wifiWant) wifiStart();
  if (timeSynced) syncFromSystem();
  renderFrame(); fadeBacklight(0, blLevel, 250);
}

static void leaveScreen() {
  if (screen == SC_NOTEEDIT) saveNote();
  if (screen == SC_WIFI) wifiScanAbort();
  if (screen == SC_WIFIPASS) pwWipe();                   // password tidak disimpan di RAM setelah layar ditutup
}
static void goHome() { leaveScreen(); goScreen(SC_HOME); }
static void goBack() {
  switch (screen) {
    case SC_NOTEEDIT: leaveScreen(); goScreen(SC_NOTES); break;
    case SC_FILEVIEW: goScreen(SC_FILES); break;
    case SC_WIFIPASS: leaveScreen(); goScreen(SC_WIFI); break;
    case SC_SYSINFO: case SC_LOCKSET: case SC_SETTIME: case SC_OTA: case SC_ABOUT: goScreen(SC_SETTINGS); break;
    case SC_PINPAD: case SC_PATTERN: goScreen(credPurpose == 1 ? SC_SETTINGS : SC_LOCKSET); break;
    case SC_HOME: break;
    default: goHome(); break;
  }
}
static void navAction(int i) {
  if (i == 0) { if (sheetOpen) closeSheet(); else goBack(); return; }
  if (sheetOpen) closeSheet();
  if (i == 1) {
    if (screen == SC_HOME && homePage > 0) { homePage = 0; homeSpring = true; lastAnimMs = millis(); buildButtons(); dirty = true; }
    else goHome();
  }
  else { if (screen == SC_RECENTS) goHome(); else { leaveScreen(); goScreen(SC_RECENTS); } }
}

// ---- buka layar Wi-Fi (dari tahan tile Wi-Fi), pilih jaringan, keyboard password ----
static void wifiOpenSettings() {
  cpOpen = false; cpMode = 0; lastAnimMs = millis();
  leaveScreen();
  wfPage = 0; wfScanRunning = false; wfScanT0 = millis() - WIFI_SCAN_MS;   // pindai langsung
  goScreen(SC_WIFI);
}
static void wfSelect(int idx) {
  if (idx < 0 || idx >= wfCount) return;
  strncpy(selSsid, wfNet[idx].ssid, 32); selSsid[32] = 0;
  selSecure = wfNet[idx].secure != 0;
  if (!selSecure) { wifiConnectTo(selSsid, ""); setToast("Menyambung..."); return; }   // jaringan terbuka: langsung sambung
  wifiScanAbort();
  pwWipe(); pwLastMs = 0;
  goScreen(SC_WIFIPASS);
}
static void pwBackspace() { if (pwLen > 0) { pwBuf[--pwLen] = 0; pwLastMs = 0; } }
static void pwConnect() {
  if (pwBusy()) return;
  if (selSecure && pwLen < 8) { setPwMsg("Password minimal 8 karakter", true); return; }
  pwMsg[0] = 0;
  wifiConnectTo(selSsid, pwBuf);
}
static void pwPress(int code) {
  if (pwBusy()) return;                                  // saat menyambung, keyboard dikunci
  pwMsg[0] = 0;
  switch (code) {
    case -1:                                             // Shift (ketuk 2x = Caps Lock) / halaman simbol
      if (kbL >= 3) kbL = (kbL == 3) ? 4 : 3;
      else if (kbL == 0) { kbL = 1; shiftTapMs = millis(); }
      else if (kbL == 1 && millis() - shiftTapMs < 400UL) kbL = 2;
      else kbL = 0;
      buildButtons(); return;
    case -2: pwBackspace(); return;
    case -3: kbL = (kbL >= 3) ? 0 : 3; buildButtons(); return;
    case -4: case 202: pwConnect(); return;
    case 201: pwShow = !pwShow; return;
    default: break;
  }
  if (code > 0 && code < 127 && pwLen < 63) {
    pwBuf[pwLen++] = (char)code; pwBuf[pwLen] = 0; pwLastMs = millis();
    if (kbL == 1) { kbL = 0; buildButtons(); }           // Shift sekali pakai
  }
}

static void kbPress(int code) {
  if (code == -1) { kbLayer = (kbLayer == 1) ? 0 : 1; buildButtons(); return; }
  if (code == -3) { kbLayer = (kbLayer == 2) ? 0 : 2; buildButtons(); return; }
  if (code == -2) { if (noteLen > 0) noteText[--noteLen] = 0; return; }
  if (code == -4) code = '\n';
  if (noteLen < 180) {
    noteText[noteLen++] = (char)code; noteText[noteLen] = 0;
    if (kbLayer == 1) { kbLayer = 0; buildButtons(); }
  }
}
static void adjustTime(int f, int d) {
  switch (f) {
    case 0: clk_hh = (clk_hh + d + 24) % 24; break;
    case 1: clk_mm = (clk_mm + d + 60) % 60; lastMinuteMs = millis(); break;
    case 2: clk_wd = (clk_wd + d + 7) % 7; break;
    case 3: clk_dd += d; if (clk_dd < 1) clk_dd = daysInMonth(clk_mo); if (clk_dd > daysInMonth(clk_mo)) clk_dd = 1; break;
    default: clk_mo = (clk_mo + d + 12) % 12; if (clk_dd > daysInMonth(clk_mo)) clk_dd = daysInMonth(clk_mo); break;
  }
}
static void setBrightFromX(int x) {
  int v = 10 + (x - 24) * 90 / 192; if (v < 10) v = 10; if (v > 100) v = 100;
  if (v != brightPct) { brightPct = v; applyBrightness(); dirty = true; }
}

// Tutup aplikasi: semua data kerjanya dibuang (bukan sekadar dihapus dari daftar)
static void closeApp(int a) {
  switch (a) {
    case 0: fCount = 0; fPage = 0; viewLen = 0; viewBuf[0] = 0; viewName[0] = 0; viewBinary = false; break;   // Berkas
    case 1: calcReset(); break;                                                                              // Kalkulator
    case 2: noteLen = 0; noteText[0] = 0; noteSlot = 0; kbLayer = 0; break;                                  // Catatan (sudah tersimpan di flash)
    case 3: swRunning = false; swAcc = 0; break;
    case 6: dinoReset(); break;
    case 7: pongReset(); break;
    case 8: flappyReset(); break;                                                             // Alat (stopwatch)
    default: break;
  }
}
static void closeAllApps() {
  for (int i = 0; i < 4; i++) { if (recents[i] >= 0) closeApp(recents[i]); recents[i] = -1; }
  wifiScanAbort(); wfCount = 0; wfPage = 0; pwWipe();     // sisa data layar Wi-Fi
  Serial.printf("Semua aplikasi ditutup. RAM bebas: %u KB\n", (unsigned)(ESP.getFreeHeap() / 1024));
}

static void act(int code) {
  switch (screen) {
    case SC_HOME: openApp(code); break;
    case SC_CALC: calcPress(code); dirty = true; break;
    case SC_NOTES: noteSlot = code - 1; loadNote(noteSlot); kbLayer = 0; goScreen(SC_NOTEEDIT); break;
    case SC_NOTEEDIT:
      if (code == 200) { noteLen = 0; noteText[0] = 0; } else kbPress(code);
      dirty = true; break;
    case SC_FILES:
      if (code == 90) { if (fPage > 0) fPage--; buildButtons(); }
      else if (code == 91) { if ((fPage + 1) * 4 < fCount) fPage++; buildButtons(); }
      else { int idx = fPage * 4 + (code - 10); if (idx < fCount) { openFileView(fNames[idx]); goScreen(SC_FILEVIEW); } }
      dirty = true; break;
    case SC_FILEVIEW: {
      if (code == 50) { char p[32]; snprintf(p, sizeof(p), "/%s", viewName); LittleFS.remove(p); goScreen(SC_FILES); }
      break;
    }
    case SC_STOPWATCH:
      if (code == 1) { if (swRunning) { swAcc += millis() - swStart; swRunning = false; } else { swStart = millis(); swRunning = true; } }
      else { swRunning = false; swAcc = 0; }
      buildButtons(); dirty = true; break;
    case SC_OTA:
      if (WiFi.status()!=WL_CONNECTED) setToast("Hubungkan Wi-Fi dahulu"); else ota::check();
      break;
    case SC_SETTINGS:
      if (code == 9) goScreen(SC_OTA);
      else if (code == 2) { sheetOpen = true; lastAnimMs = millis(); dirty = true; }
      else if (code == 3) goScreen(SC_SETTIME);
      else if (code == 4) { calibrate(); goScreen(SC_SETTINGS); }
      else if (code == 5) goSleep();
      else if (code == 6) goScreen(SC_ABOUT);
      else if (code == 7) {                              // kunci layar: minta PIN/pola lama dulu bila sudah aktif
        if (lkType == 0) goScreen(SC_LOCKSET);
        else { credPurpose = 1; goScreen(lkType == 1 ? SC_PINPAD : SC_PATTERN); }
      }
      else if (code == 8) goScreen(SC_SYSINFO);
      break;
    case SC_LOCKSET:
      if (code == 1) {
        if (lkType != 0) { lkType = 0; lkHash = 0; prefs.putUChar("lkT", 0); prefs.putUInt("lkH", 0); setToast("Kunci layar dimatikan"); }
        buildButtons(); dirty = true;
      } else { credPurpose = 2; goScreen(code == 2 ? SC_PINPAD : SC_PATTERN); }
      break;
    case SC_SETTIME: adjustTime(code / 2, (code & 1) ? 1 : -1); dirty = true; break;
    case SC_RECENTS:
      if (code == 99) { closeAllApps(); buildButtons(); dirty = true; }
      else if (code >= 0 && code < 4 && recents[code] >= 0) openApp(recents[code]);
      break;
    case SC_WIFI:
      if (code == 1) { wifiToggle(); dirty = true; }
      else if (code == 90) { if (wfPage > 0) wfPage--; dirty = true; }
      else if (code == 91) { if ((wfPage + 1) * 5 < wfCount) wfPage++; dirty = true; }
      else if (code >= 10 && code < 15) wfSelect(wfPage * 5 + (code - 10));
      break;
    case SC_WIFIPASS: pwPress(code); dirty = true; break;
    default: break;
  }
}

static void cpSetBright(int x) {
  int v = 10 + (x - 46) * 90 / 160; if (v < 10) v = 10; if (v > 100) v = 100;
  if (v != brightPct) { brightPct = v; applyBrightness(); dirty = true; }
}

static void cpTap(int x, int y) {                        // panel terbuka penuh (oy = 0)
  dirty = true;
  if (cpMode == 1) {                                     // pilih warna senter
    for (int k = 0; k < 8; k++) {
      int cx = 39 + (k % 4) * 54, cy = 160 + (k / 4) * 50;
      if (abs(x - cx) <= 25 && abs(y - cy) <= 24) { flashPick(k); cpMode = 0; return; }
    }
    cpMode = 0; return;
  }
  if (cpMode == 2) {                                     // konfirmasi deep sleep
    if (y >= 184 && y < 220 && x >= 126 && x < 216) { enterDeepSleep(); return; }
    cpMode = 0; return;
  }
  if (y > CP_H) { cpOpen = false; return; }              // ketuk di luar panel = tutup
  if (!locked && y < 55 && (ota::state == ota::Available || ota::state == ota::Writing)) { closePanelNow(); leaveScreen(); goScreen(SC_OTA); return; }
  switch (cpHitTile(x, y)) {
    case 0: wifiToggle(); break;
    case 1: flashToggle(); break;
    case 2: cpOpen = false; locked = true; lockShift = 0; lockAuth = false; credReset(); break;
    case 3: goSleep(); break;
    case 4: cpMode = 2; break;
    case 5: if (!locked) { cpOpen = false; leaveScreen(); goScreen(SC_SETTINGS); } break;
    default: break;
  }
}

static void onTap(int x, int y) {
  if (cpOpen) { if (cpAnim > 0.95f) cpTap(x, y); return; }
  if (locked) return;
  if (y >= NAV_Y) { navAction(x < 90 ? 0 : (x < 150 ? 1 : 2)); return; }
  if (sheetOpen) {
    if (y < SHEET_TOP_OPEN - 4) { closeSheet(); return; }
    if (x > 196 && y < SHEET_TOP_OPEN + 44) { closeSheet(); return; }
    static const int DX[3] = {50, 120, 190};
    int cy = SHEET_TOP_OPEN + 85;
    for (int i = 0; i < 3; i++) if (abs(x - DX[i]) <= 34 && y >= cy - 30 && y <= cy + 42) { applyTheme(i); return; }
    return;
  }
  int id = hitBtn(x, y);
  if (id >= 0) act(btns[id].code);
}

// ============================== KUNCI LAYAR: LOGIKA ==========================
static uint32_t credHash(uint8_t type, const char* s) {
  uint32_t h = 2166136261UL ^ (uint32_t)(ESP.getEfuseMac() & 0xFFFFFFFFULL) ^ ((uint32_t)type * 0x9E3779B1UL);
  for (const char* p = s; *p; p++) { h ^= (uint8_t)*p; h *= 16777619UL; }
  return h;
}
static void credMsgSet(const char* m, bool err) {
  strncpy(credMsg, m, sizeof(credMsg) - 1); credMsg[sizeof(credMsg) - 1] = 0;
  credMsgErr = err; credMsgT = millis(); dirty = true;
}
static void credFail(const char* m) {                  // salah: PIN bergetar, pola merah sebentar
  credShakeT = millis(); credMsgSet(m, true);
  credLen = 0; credBuf[0] = 0;
  if (credKind() == 2) { patErr = true; patErrT = millis(); }
}
static void credSubmit(const char* s) {
  int kind = credKind(), len = (int)strlen(s);
  if (len < 4) { credFail(kind == 1 ? "Minimal 4 angka" : "Hubungkan minimal 4 titik"); return; }
  uint32_t now = millis();
  if (credPurpose <= 1) {                              // verifikasi: buka kunci / sebelum mengubah
    if (now < credLockUntil) { char b[40]; snprintf(b, sizeof(b), "Coba lagi dalam %us", (unsigned)((credLockUntil - now + 999) / 1000)); credFail(b); return; }
    if (credHash((uint8_t)kind, s) == lkHash) {
      credFails = 0;
      if (credPurpose == 0) { lockAuth = false; locked = false; lockShift = 0; credReset(); dirty = true; }
      else goScreen(SC_LOCKSET);
    } else if (++credFails >= 5) { credFails = 0; credLockUntil = now + 30000UL; credFail("Terlalu banyak salah, tunggu 30 dtk"); }
    else credFail(kind == 1 ? "PIN salah" : "Pola salah");
    return;
  }
  if (credPurpose == 2) {                              // entri pertama -> minta konfirmasi
    strncpy(credTmp, s, 9); credTmp[9] = 0; credPurpose = 3;
    credReset(); credMsgSet("Ulangi untuk konfirmasi", false);
    return;
  }
  if (!strcmp(credTmp, s)) {                           // konfirmasi cocok -> simpan
    lkType = (uint8_t)kind; lkHash = credHash((uint8_t)kind, s);
    prefs.putUChar("lkT", lkType); prefs.putUInt("lkH", lkHash);
    credTmp[0] = 0; credFails = 0;
    setToast(kind == 1 ? "PIN disimpan" : "Pola disimpan");
    goScreen(SC_LOCKSET);
  } else { credPurpose = 2; credTmp[0] = 0; credFail("Tidak sama, ulangi dari awal"); }
}
static void patAdd(int n) {
  for (int i = 0; i < patLen; i++) if (patSeq[i] == n) return;
  if (patLen > 0) {                                    // garis melewati titik di tengah -> ikut terpilih
    int m = patSeq[patLen - 1], r1 = m / 3, c1 = m % 3, r2 = n / 3, c2 = n % 3;
    if (((r1 + r2) % 2 == 0) && ((c1 + c2) % 2 == 0)) {
      int mid = ((r1 + r2) / 2) * 3 + (c1 + c2) / 2; bool seen = false;
      for (int i = 0; i < patLen; i++) if (patSeq[i] == mid) seen = true;
      if (!seen && patLen < 9) patSeq[patLen++] = (uint8_t)mid;
    }
  }
  if (patLen < 9) patSeq[patLen++] = (uint8_t)n;
}
static void credDown(int x, int y) {
  lockAuthLast = millis();
  credTouch = true; credCancelDown = false; ignoreTouch = true;
  if (locked && y >= 286) { credCancelDown = true; return; }
  credMsg[0] = 0;
  if (credKind() == 1) credKey = (int8_t)pinKeyAt(x, y);
  else { patErr = false; patLen = 0; patDrag = true; patFx = (float)x; patFy = (float)y; int n = patDotAt(x, y); if (n >= 0) patAdd(n); }
  dirty = true;
}
static void credMove(int x, int y) {
  lockAuthLast = millis();
  if (credCancelDown) return;
  if (credKind() == 1) { if (credKey >= 0 && pinKeyAt(x, y) != credKey) credKey = -1; }
  else if (patDrag) { patFx = (float)x; patFy = (float)y; int n = patDotAt(x, y); if (n >= 0) patAdd(n); dirty = true; }
}
static void credUp() {
  credTouch = false; lockAuthLast = millis();
  if (credCancelDown) { credCancelDown = false; if (locked) { lockAuth = false; credReset(); } dirty = true; return; }
  if (credKind() == 1) {
    int k = credKey; credKey = -1;
    if (k < 0) return;
    if (k == 9) { if (credLen) credBuf[--credLen] = 0; }
    else if (k == 11) credSubmit(credBuf);
    else if (credLen < 8) { credBuf[credLen++] = (char)(k == 10 ? '0' : '1' + k); credBuf[credLen] = 0; credPopT = millis(); }
  } else {
    patDrag = false;
    if (patLen == 0) return;
    char s[10]; for (int i = 0; i < patLen; i++) s[i] = (char)('0' + patSeq[i]);
    s[patLen] = 0;
    credSubmit(s);
  }
  dirty = true;
}

static float cpRubber(float r) {                         // tarikan melewati batas terasa "kenyal"
  if (r < 0) return 0;
  if (r > 1) return 1.0f + 0.06f * tanhf((r - 1.0f) * 3.0f);
  return r;
}
static inline bool uiBusy() { return trActive || (lockSpring && lockTarget > 100.0f); }

static void pollTouch() {
  int sx, sy;
  bool pr = tsRead(sx, sy);
  if (pr) {
    tMiss = 0;
    if (sleeping) {
      if (++tPend >= (SLEEP_LIGHT ? 1 : 2)) { tPend = 0; wake(); ignoreTouch = true; tDown = true; tBlocked = false; t0x = tx = sx; t0y = ty = sy; }
      return;
    }
    if (!tDown) {
      if (++tPend < (isGameScreen(screen) ? 1 : 2)) return;   // butuh 2 pembacaan berurutan (anti-noise); game: 1 agar responsif
      tPend = 0; tDown = true; ignoreTouch = false; bsNext = 0;
      t0x = tx = sx; t0y = ty = sy; tT0 = millis();
      fxs = (float)sx; fys = (float)sy; tvy = 0; tvx = 0; tLastMs = tT0; tLastY = fys; tLastX = fxs;
      tBlocked = uiBusy();                          // sedang transisi / membuka kunci: sentuhan diabaikan
      if (tBlocked) return;
      pressedId = -1; pressedNav = -1; cpPress = -1; cpHold = 0;
      cpSlide = false; cpDrag = false; homeDrag = false; cpLongDone = false; lockDrag = false; lockShift = 0; swipeTop = false; credTouch = false;
      lockSpring = false; lockSnapOK = false;
      if (cpOpen) {
        if (cpAnim > 0.9f && cpMode == 0) {
          if (sy >= 54 && sy < 96) { cpSlide = true; cpSetBright(sx); }      // slider kecerahan
          else cpPress = cpHitTile(sx, sy);
        }
      } else if (!sheetOpen) {
        swipeTop = (sy < 34);                       // mulai dari tepi atas = tarik control panel
        if (locked) { if (lockAuth) { lockDrag = false; if (!swipeTop) credDown(sx, sy); } else lockDrag = !swipeTop; }   // lock screen: geser ke atas / PIN / pola
        else {
          if (sy >= NAV_Y) pressedNav = sx < 90 ? 0 : (sx < 150 ? 1 : 2); else pressedId = (screen == SC_HOME && !homeSettled()) ? -1 : hitBtn(sx, sy);
          if (credScreen() && !swipeTop && sy < NAV_Y) credDown(sx, sy);
          if (pressedId >= 0 && btns[pressedId].style != B_APP) { rip.on = true; rip.bi = pressedId; rip.x = (float)sx; rip.y = (float)sy; rip.t0 = millis(); }
        }
      }
      dirty = true;
    } else {
      if (tBlocked) return;
      fxs += (sx - fxs) * 0.6f; fys += (sy - fys) * 0.6f;      // saring getaran sentuhan
      tx = (int)(fxs + 0.5f); ty = (int)(fys + 0.5f);
      uint32_t nm = millis();
      if (nm > tLastMs) { float inst = (fys - tLastY) * 1000.0f / (float)(nm - tLastMs); tvy = tvy * 0.6f + inst * 0.4f; float ix = (fxs - tLastX) * 1000.0f / (float)(nm - tLastMs); tvx = tvx * 0.6f + ix * 0.4f; tLastMs = nm; tLastY = fys; tLastX = fxs; }
      int dx = tx - t0x, dy = ty - t0y;
      if (cpSlide) cpSetBright(tx);
      else if (cpDrag) {                            // panel mengikuti jari (kenyal di batas)
        cpAnim = cpRubber(cpDragP0 + (ty - cpDragY0) / (CP_H * 0.8f)); cpV = 0;
        dirty = true;
      } else if (!sheetOpen) {
        if (homeDrag) { homePos = homeRubber(homeDragP0 - (float)dx); dirty = true; }
        else if (screen == SC_HOME && !cpOpen && !cpDrag && !locked && !swipeTop && abs(dx) > 14 && abs(dx) > abs(dy)) {
          homeDrag = true; homeSpring = false; homeV = 0; homeDragP0 = homePos; pressedId = pressedNav = -1; rip.on = false; dirty = true;   // geser halaman beranda
        }
        else if (!cpOpen && swipeTop && dy > 12 && dy > abs(dx)) { cpDrag = true; cpMode = 0; pressedId = pressedNav = -1; lockDrag = false; lockShift = 0; cpDragP0 = cpAnim; cpDragY0 = ty; }
        else if (cpOpen && cpMode == 0 && dy < -12 && -dy > abs(dx)) { cpDrag = true; cpPress = -1; cpHold = 0; cpDragP0 = cpAnim; cpDragY0 = ty; }
        else if (lockDrag && !cpOpen) {
          int s = -dy; if (s < 0) s = 0; if (s > 240) s = 240;
          if (s > 0 && !lockSnapOK && snapBuf2 && lkType == 0) {   // siapkan layar di balik kunci (dirender sekali)
            locked = false; u16* keep = fb; fb = snapBuf2; drawScene(); fb = keep; locked = true; lockSnapOK = true;
          }
          if (s != lockShift) { lockShift = s; dirty = true; }
        }
      }
      if (credTouch && !cpDrag) credMove(tx, ty);
      if ((abs(dx) > 16 || abs(dy) > 16) && (pressedId >= 0 || pressedNav >= 0 || cpPress >= 0)) { pressedId = pressedNav = -1; cpPress = -1; cpHold = 0; dirty = true; }
      // tahan tile di control panel: Senter -> pilih warna LED, Wi-Fi -> Pengaturan Wi-Fi
      if (cpOpen && (cpPress == 0 || cpPress == 1) && !cpLongDone && abs(dx) < 14 && abs(dy) < 14) {
        uint32_t el = millis() - tT0;
        cpHold = el > 120 ? (float)(el - 120) / (float)(LONG_PRESS_MS - 120) : 0.0f;
        if (cpHold > 1) cpHold = 1;
        dirty = true;
        if (el >= LONG_PRESS_MS) {
          cpLongDone = true; ignoreTouch = true; cpHold = 0;
          int tile = cpPress; cpPress = -1; cpSv[tile] = -9.0f;      // "klik": tile memantul
          if (tile == 1) cpMode = 1;
          else if (!locked) wifiOpenSettings();
        }
      }
      // tahan tombol hapus di keyboard password = hapus berulang
      if (screen == SC_WIFIPASS && !cpOpen && !locked && pressedId >= 0 && pressedId < nbtn && btns[pressedId].code == -2) {
        uint32_t nowMs = millis();
        if (nowMs - tT0 >= 450UL && nowMs >= bsNext) { bsNext = nowMs + 60UL; ignoreTouch = true; if (!pwBusy()) pwBackspace(); dirty = true; }
      }
    }
  } else {
    tPend = 0;
    if (tDown) {
      if (tMiss == 0) tMissT0 = millis();
      tMiss++;
      if (tMiss >= 2 && (isGameScreen(screen) || millis() - tMissT0 >= 40)) {          // lepas jari (>= 2 bacaan kosong & >= 40 ms)
        tDown = false; tMiss = 0;
        bool blocked = tBlocked; tBlocked = false;
        pressedId = -1; pressedNav = -1; cpPress = -1; cpHold = 0;
        if (!blocked) {
          bool wasSlide = cpSlide; cpSlide = false;
          if (wasSlide) prefs.putUChar("bri", (uint8_t)brightPct);
          if (homeDrag) {                                     // lepas: pilih halaman terdekat / sesuai lemparan
            homeDrag = false;
            int pg = (int)floorf(homePos / (float)SCR_W + 0.5f);
            if (tvx < -420.0f) pg = homePage + 1; else if (tvx > 420.0f) pg = homePage - 1;
            if (pg < 0) pg = 0; if (pg > HOME_PAGES - 1) pg = HOME_PAGES - 1;
            homePage = pg; homeSpring = true; homeV = -tvx * 0.5f; lastAnimMs = millis();
            buildButtons();
          } else if (cpDrag) {
            cpDrag = false;
            bool open;
            if (tvy > 650.0f) open = true;                  // lemparan cepat ke bawah / atas menentukan arah
            else if (tvy < -650.0f) open = false;
            else open = cpAnim > (cpOpen ? 0.6f : 0.35f);
            cpOpen = open;
            cpV = tvy / (CP_H * 0.8f) * 0.6f;               // lanjutkan momentum jari ke pegas
            if (cpV > 6) cpV = 6; if (cpV < -6) cpV = -6;
            if (!cpOpen) cpMode = 0;
            lastAnimMs = millis();
          } else if (lockDrag && lockShift > 0) {
            bool unlock = lockShift > 70 || tvy < -600.0f;
            lockSpring = true; lockPos = (float)lockShift; lockVel = -tvy * 0.6f; lockTarget = unlock ? 250.0f : 0.0f;
            lastAnimMs = millis();
          } else if (credTouch) {
            credUp();
          } else if (!ignoreTouch) {
            int dx = abs(tx - t0x), dy = ty - t0y;
            if (sheetOpen && t0y >= SHEET_TOP_OPEN && dy > 36) closeSheet();
            else if (dx < 18 && abs(dy) < 18 && millis() - tT0 < 900) onTap(t0x, t0y);
          }
          lockDrag = false; if (!lockSpring) lockShift = 0; swipeTop = false;
        }
        dirty = true;
      }
    }
  }
}

// gerakkan semua pegas efek sentuhan; true = masih ada yang bergerak
static bool updateSprings(float dt) {
  bool moving = false;
  const float K = 520.0f, C = 26.0f;
  for (int i = 0; i < nbtn; i++) {
    float tg = (i == pressedId) ? 1.0f : 0.0f;
    if (bpX[i] != tg || bpV[i] != 0) {
      springStep(bpX[i], bpV[i], tg, dt, K, C);
      if (fabsf(bpX[i] - tg) < 0.004f && fabsf(bpV[i]) < 0.05f) { bpX[i] = tg; bpV[i] = 0; } else moving = true;
    }
  }
  for (int i = 0; i < 3; i++) {
    float tg = (i == pressedNav) ? 1.0f : 0.0f;
    if (navSp[i] != tg || navSv[i] != 0) {
      springStep(navSp[i], navSv[i], tg, dt, K, C);
      if (fabsf(navSp[i] - tg) < 0.004f && fabsf(navSv[i]) < 0.05f) { navSp[i] = tg; navSv[i] = 0; } else moving = true;
    }
  }
  for (int i = 0; i < 6; i++) {
    float tg = (i == cpPress) ? 1.0f : 0.0f;
    if (cpSx[i] != tg || cpSv[i] != 0) {
      springStep(cpSx[i], cpSv[i], tg, dt, K, C);
      if (fabsf(cpSx[i] - tg) < 0.004f && fabsf(cpSv[i]) < 0.05f) { cpSx[i] = tg; cpSv[i] = 0; } else moving = true;
    }
  }
  {
    float tg = (tDown && !tBlocked && swipeTop && !cpDrag && !cpOpen) ? 1.0f : 0.0f;
    if (topHintX != tg || topHintV != 0) {
      springStep(topHintX, topHintV, tg, dt, 380.0f, 28.0f);
      if (fabsf(topHintX - tg) < 0.004f && fabsf(topHintV) < 0.05f) { topHintX = tg; topHintV = 0; } else moving = true;
    }
  }
  for (int k = 0; k < 12; k++) {
    float tg = (credKey == k && credTouch) ? 1.0f : 0.0f;
    if (credSp[k] != tg || credSv[k] != 0) {
      springStep(credSp[k], credSv[k], tg, dt, K, C);
      if (fabsf(credSp[k] - tg) < 0.004f && fabsf(credSv[k]) < 0.05f) { credSp[k] = tg; credSv[k] = 0; } else moving = true;
    }
  }
  {
    uint32_t nw = millis();
    if (credShakeT && nw - credShakeT < 460) moving = true;
    if (credPopT && nw - credPopT < 170) moving = true;
    if (patErr && nw - patErrT > 650) { patLen = 0; patErr = false; moving = true; }
    if (credMsg[0] && nw - credMsgT > 3500) { credMsg[0] = 0; moving = true; }
    if (credMsg[0] && credMsgErr && nw - credMsgT < 650) moving = true;
  }
  if (rip.on) { if (millis() - rip.t0 > 430) rip.on = false; else moving = true; }
  return moving;
}

// ============================== SETUP & LOOP =================================
void setup() {
  Serial.begin(115200);
  delay(100);

  // ── Inisialisasi PSRAM paling awal ──────────────────────────────────────────
  // Wajib: Arduino IDE → Tools → PSRAM → "OPI PSRAM"
  psramManagerInit();
  // ────────────────────────────────────────────────────────────────────────────

  gpio_hold_dis((gpio_num_t)PIN_TFT_BL); gpio_deep_sleep_hold_dis();   // lepas hold setelah deep sleep
  ledWrite(0, 0, 0);                                                     // pastikan LED senter padam
  pinMode(PIN_TS_CS, OUTPUT);  digitalWrite(PIN_TS_CS, HIGH);
  pinMode(PIN_TFT_CS, OUTPUT); digitalWrite(PIN_TFT_CS, HIGH);
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(PIN_TFT_BL, 5000, 8);
#else
  ledcSetup(0, 5000, 8); ledcAttachPin(PIN_TFT_BL, 0);
#endif
  setBacklight(0);

  tftSPI.begin(PIN_TFT_SCK, PIN_TFT_MISO, PIN_TFT_MOSI, -1);
  tft.begin(TFT_SPI_HZ);
  tft.setRotation(TFT_ROTATION);
  if (TFT_INVERT) tft.invertDisplay(true);
  tft.fillScreen(0x0000);

  if (!initAssets()) { Serial.println("Gagal memuat font/ikon"); setBacklight(255); tft.fillScreen(ILI9341_RED); while (true) delay(1000); }
  fb = allocFrame(true);
  if (!fb) { if (ota::pending()) esp_ota_mark_app_invalid_rollback_and_reboot(); Serial.println("Gagal alokasi framebuffer"); setBacklight(255); tft.fillScreen(ILI9341_RED); while (true) delay(1000); }
  bgBuf = allocFrame(false);
  snapBuf = allocFrame(false);
  snapBuf2 = allocFrame(false);
  fbAlt = allocFrame(false);
  startPushTask();
  fsOK = LittleFS.begin(!ota::pending());
  Serial.printf("RAM internal bebas : %u KB (blok terbesar %u KB)\n",
    (unsigned)(ESP.getFreeHeap() / 1024),
    (unsigned)(heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) / 1024));
  psramPrintStats();
  Serial.printf("bgCache:%s  crossfade:%s  flash-fs:%s  transisi:%s  pipeline:%s\n",
    bgBuf ? "ya" : "tidak", snapBuf ? "ya" : "tidak", fsOK ? "ya" : "tidak",
    trReady() ? "ya" : "tidak", pushTaskH ? "ya" : "tidak");

  APPS[0] = {"Berkas",     H(0x2A2616), H(0x4A4228), H(0xF4C24E), &IC_FOLDER, &IC_FOLDER_BIG};
  APPS[1] = {"Kalkulator", H(0x32200F), H(0x5A3E1E), H(0xFFA94D), &IC_CALC,   &IC_CALC_BIG};
  APPS[2] = {"Catatan",    H(0x16263A), H(0x2D4966), H(0x8CC8FF), &IC_NOTES,  &IC_NOTES_BIG};
  APPS[3] = {"Stopwatch",  H(0x143A33), H(0x2A5C51), H(0x4EE3B5), &IC_TOOLS,  &IC_TOOLS_BIG};
  APPS[4] = {"Tema",       H(0x1E2036), H(0x373C66), H(0xA8A4FF), &IC_THEME,  &IC_THEME_BIG};
  APPS[5] = {"Setelan",    H(0x1E232B), H(0x3A424E), H(0xD6DBE3), &IC_GEAR,   &IC_GEAR_BIG};
  APPS[6] = {"Dino",       H(0x24272C), H(0x474D56), H(0xE8EAED), &IC_G_DINO, &IC_G_DINO};
  APPS[7] = {"Ping Pong",  H(0x14301F), H(0x2A5C3E), H(0x6EF0A0), &IC_G_PONG, &IC_G_PONG};
  APPS[8] = {"Flappy",     H(0x33290F), H(0x66521E), H(0xFFD43B), &IC_G_FLAP, &IC_G_FLAP};

  prefs.begin("espos", false);
  gamesLoad();                                           // skor terbaik game
  curTheme = prefs.getUChar("tema", 0); if (curTheme > 2) curTheme = 0;
  brightPct = prefs.getUChar("bri", 100); if (brightPct < 10 || brightPct > 100) brightPct = 100;
  lkType = prefs.getUChar("lkT", 0); lkHash = prefs.getUInt("lkH", 0); if (lkType > 2) lkType = 0;
  blLevel = 25 + (230 * brightPct) / 100;
  wifiWant = prefs.getUChar("wifi", 1) != 0;
  {                                                       // jaringan Wi-Fi tersimpan (default: define WIFI_SSID / WIFI_PASS)
    String ws = prefs.getString("wssid", WIFI_SSID), wp = prefs.getString("wpass", WIFI_PASS);
    strncpy(wifiSsid, ws.c_str(), 32); wifiSsid[32] = 0;
    strncpy(wifiPass, wp.c_str(), 63); wifiPass[63] = 0;
  }
  if (prefs.getUChar("cok", 0)) {
    calX0 = prefs.getInt("cx0", calX0); calX1 = prefs.getInt("cx1", calX1);
    calY0 = prefs.getInt("cy0", calY0); calY1 = prefs.getInt("cy1", calY1);
    calSwap = prefs.getUChar("csw", 0); calOK = true;
  }

  screen = SC_HOME; locked = true; buildButtons();
  if (wifiWant) wifiStart();                     // Wi-Fi menyambung sambil animasi boot
  bootSequence();
  if (ota::pending()) {
    if (!fsOK || esp_ota_mark_app_valid_cancel_rollback()!=ESP_OK) esp_ota_mark_app_invalid_rollback_and_reboot();
  }
  if (!calOK) calibrate();                       // pertama kali: kalibrasi touch otomatis
  lastMinuteMs = millis(); lastAnimMs = millis();
  dirty = true;
}

void loop() {
  uint32_t now = millis();
  if (sleeping) {
    waitPush();
    pollTouch();
    if (sleeping) {
#if SLEEP_LIGHT
      esp_sleep_enable_timer_wakeup(150000ULL);    // bangun tiap 150 ms untuk cek sentuhan
      esp_light_sleep_start();
#else
      delay(20);
#endif
    }
    return;
  }
  if (tickClock(now)) dirty = true;
  wifiTask(now);
  ota::tick();
  static ota::State prev=ota::Idle;
  auto status=ota::state.load();
  if (prev!=status) { prev=status; if (screen==SC_OTA) buildButtons(); dirty=true; }
  wifiScanTask(now);

  float dt = (now - lastAnimMs) / 1000.0f;
  if (dt > 0.05f) dt = 0.05f;
  lastAnimMs = now;

  // sheet tema: pegas
  {
    float target = sheetOpen ? 1.0f : 0.0f;
    if (sheetAnim != target || sheetV != 0) {
      springStep(sheetAnim, sheetV, target, dt, 300.0f, 26.0f);
      if (!sheetOpen && sheetAnim < 0) { sheetAnim = 0; sheetV = 0; }
      if (fabsf(sheetAnim - target) < 0.002f && fabsf(sheetV) < 0.02f) { sheetAnim = target; sheetV = 0; }
      dirty = true;
    }
  }
  // control panel: pegas (meneruskan kecepatan lemparan jari)
  if (!cpDrag) {
    float ct = cpOpen ? 1.0f : 0.0f;
    if (cpAnim != ct || cpV != 0) {
      springStep(cpAnim, cpV, ct, dt, 260.0f, 23.0f);
      if (cpAnim < 0 && !cpOpen) { cpAnim = 0; cpV = 0; }
      if (fabsf(cpAnim - ct) < 0.002f && fabsf(cpV) < 0.02f) { cpAnim = ct; cpV = 0; }
      if (cpAnim == 0) cpMode = 0;
      dirty = true;
    }
  }
  // lock screen: lanjutkan geser sampai terbuka, atau kembali jika dibatalkan
  if (lockSpring) {
    springStep(lockPos, lockVel, lockTarget, dt, 240.0f, 27.0f);
    if (lockPos < 0) { lockPos = 0; lockVel = 0; }
    lockShift = (int)lockPos;
    if (lockTarget > 100.0f && lockPos >= 238.0f) {
      lockShift = 0; lockSpring = false; lockSnapOK = false;
      if (lkType != 0) { lockAuth = true; lockAuthT = now; lockAuthLast = now; credPurpose = 0; credReset(); }   // minta PIN / pola
      else locked = false;
    }
    else if (lockTarget < 1.0f && lockPos < 0.6f && fabsf(lockVel) < 4.0f) { lockShift = 0; lockSpring = false; lockSnapOK = false; }
    dirty = true;
  }
  if (locked && lockAuth) {
    if (now - lockAuthLast > 25000UL) { lockAuth = false; credReset(); dirty = true; }     // tak ada sentuhan: kembali ke lock screen
    else if (now - lockAuthT < 260) dirty = true;
  }
  if (homeSpring && !homeDrag) {                         // beranda: pegas ke halaman tujuan
    float tg = (float)(homePage * SCR_W);
    springStep(homePos, homeV, tg, dt, 320.0f, 28.0f); dirty = true;
    if (fabsf(homePos - tg) < 0.4f && fabsf(homeV) < 8.0f) { homePos = tg; homeV = 0; homeSpring = false; }
  }
  if (updateSprings(dt)) dirty = true;
  if (isGameScreen(screen) && !locked && !trActive && !cpOpen && cpAnim < 0.01f && !sheetOpen) { gameStep(now); dirty = true; }   // game: jalan tiap frame
  if (screen == SC_STOPWATCH && swRunning) dirty = true;
  if (locked && !lockDrag && !lockSpring && !lockAuth) { static uint32_t ll = 0; if (now - ll > 50) { ll = now; dirty = true; } }   // petunjuk geser bergerak
  if (screen == SC_NOTEEDIT) { static uint32_t lb = 0; if (now - lb > 450) { lb = now; dirty = true; } }
  if (screen == SC_WIFIPASS) { static uint32_t lw = 0; if (now - lw > 250) { lw = now; dirty = true; } }   // kursor berkedip
  if (screen == SC_WIFI)     { static uint32_t lq = 0; if (now - lq > 500) { lq = now; dirty = true; } }   // toast / indikator pindai
  if (screen == SC_SYSINFO)  { static uint32_t ls = 0; if (now - ls > 1000) { ls = now; dirty = true; } }

  // 1) gambar frame (tumpang-tindih dengan pengiriman frame sebelumnya)
  bool rendered = false;
  if (trActive) { if (!trFrame(now)) { trActive = false; dirty = true; } rendered = true; }
  else if (dirty) { dirty = false; drawScene(); rendered = true; }

  // 2) baca sentuhan saat SPI bebas, 3) kirim frame di latar belakang
  waitPush();
  pollTouch();
  if (rendered) presentFrame(); else delay(4);
}
