static bool wfIsCur(const char* ssid)  { return wifiSt == WF_ON && wifiSsid[0] && !strcmp(ssid, wifiSsid); }
static bool wfIsConn(const char* ssid) { return wifiSt == WF_CONNECTING && !strcmp(ssid, pendSave ? pendSsid : wifiSsid); }
static int  wfBars(int rssi) { return rssi >= -55 ? 4 : (rssi >= -65 ? 3 : (rssi >= -75 ? 2 : 1)); }

static void drawSignal(int x, int yb, int lv, u16 c) {
  for (int i = 0; i < 4; i++) { int hh = 4 + i * 3; rrect(x + i * 5, yb - hh, 3.4f, hh, 1.2f, c, i < lv ? 255 : 55); }
}
static void drawLockMini(float cx, float cy, u16 c) {
  ringS(cx, cy - 3, 3.6f, 1.6f, c);
  rrect(cx - 5, cy - 1, 10, 8, 2, c);
}

static void drawWifiScreen() {
  const Theme& t = THEMES[curTheme];
  bool on = wifiWant;
  rrect(186, 40, 42, 22, 11, on ? t.accent : H(0x39445A));            // saklar
  disc(on ? 217.0f : 197.0f, 51, 8.5f, COL_WHITE);

  int pages = (wfCount + 4) / 5; if (pages < 1) pages = 1;
  if (wfPage >= pages) wfPage = pages - 1;

  if (wfToast[0] && millis() < wfToastUntil) drawText(F8, 16, 77, wfToast, t.accent);
  else drawText(F8, 16, 77, on ? "Jaringan tersedia" : "Wi-Fi mati", COL_MUTED);
  if (on && wfScanRunning) disc(124, 74.5f, 2.2f, t.accent);          // titik = sedang memindai
  if (pages > 1) {
    char pg[12]; snprintf(pg, sizeof(pg), "%d/%d", wfPage + 1, pages);
    drawText(F8, 184, 77, pg, COL_MUTED, 255, 1);
    bool pv = wfPage > 0, nx = (wfPage + 1) < pages;
    drawIcon(IC_CHEV_L, 150, 74, pv ? COL_LABEL : COL_MUTED2, pv ? 255 : 80);
    drawIcon(IC_CHEV_R, 218, 74, nx ? COL_LABEL : COL_MUTED2, nx ? 255 : 80);
  }

  if (!on) {
    drawText(B13, 120, 150, "Wi-Fi mati", COL_LABEL, 255, 1);
    drawText(F8, 120, 168, "Nyalakan saklar untuk mencari jaringan", COL_MUTED, 255, 1);
    return;
  }
  if (wfCount == 0) {
    drawText(B13, 120, 150, "Memindai jaringan...", COL_LABEL, 255, 1);
    drawText(F8, 120, 168, "Dipindai ulang otomatis tiap 2 detik", COL_MUTED, 255, 1);
    return;
  }
  for (int i = 0; i < 5; i++) {
    int idx = wfPage * 5 + i; if (idx >= wfCount) break;
    const WfNet& n = wfNet[idx];
    int y = 84 + i * 40;
    float pv = clamp01(bpX[3 + i]);                       // tombol baris jaringan = indeks 3..7
    bool cur = wfIsCur(n.ssid), cing = wfIsConn(n.ssid);
    rrect(12, y, 216, 36, 12, H(0xFFFFFF), (uint8_t)((cur ? 22.0f : 14.0f) + 20.0f * pv));
    drawRipple(3 + i, 12, y, 216, 36, 12);
    rrect(12.5f, y + 0.5f, 215, 35, 11.5f, cur ? t.accent : H(0xFFFFFF), cur ? 120 : 24, 1.0f);
    drawSignal(24, y + 25, wfBars(n.rssi), cur ? t.accent : COL_TEXT);
    char nm[34]; fitText(F10, n.ssid, 140, nm, sizeof(nm));
    drawText(F10, 52, y + 16, nm, COL_TEXT);
    const char* sub = cur ? "Terhubung" : (cing ? "Menyambung..." : (n.secure ? "Dilindungi" : "Terbuka"));
    drawText(F8, 52, y + 29, sub, (cur || cing) ? t.accent : COL_MUTED);
    if (n.secure) drawLockMini(214, y + 18, COL_MUTED2);
  }
}

