// ============================== WALLPAPER ====================================
static void renderBG(const Theme& t) {
  for (int y = 0; y < SCR_H; y++) {
    u16 c = mix(t.bgBot, t.bgTop, (uint8_t)(255 - y * 255 / (SCR_H - 1)));
    u16* row = fb + y * SCR_W;
    for (int x = 0; x < SCR_W; x++) row[x] = c;
  }
  glow(218, 238, 118, t.glowA, t.gaA);
  glow(6, 322, 105, t.glowB, t.gaB);
  arcLine(318, 262, 128, 1.6f, 128, 232, t.arc, t.arcAlpha);
  arcLine(318, 262, 146, 1.4f, 132, 228, t.arc, t.arcAlpha * 2 / 3);
  arcLine(318, 262, 166, 1.2f, 136, 224, t.arc, t.arcAlpha / 2);
}
static void copyBG() {
  if (bgBuf) {
    if (bgTheme != curTheme) { renderBG(THEMES[curTheme]); memcpy(bgBuf, fb, FB_BYTES); bgTheme = curTheme; }
    else memcpy(fb, bgBuf, FB_BYTES);
  } else renderBG(THEMES[curTheme]);
}

// ============================== EASING =======================================
static float easeOut(float x) { x = x < 0 ? 0 : (x > 1 ? 1 : x); return 1 - (1 - x) * (1 - x) * (1 - x); }
static float smooth(float x)  { x = x < 0 ? 0 : (x > 1 ? 1 : x); return x * x * (3 - 2 * x); }
static float clamp01(float v) { return v < 0 ? 0 : (v > 1 ? 1 : v); }
static float easeUI(float x)  { float a = easeOut(x), b = smooth(x); return a * 0.7f + b * 0.3f; }   // start lembut, akhir melambat

// pegas (semi-implicit Euler, dipecah jadi langkah kecil agar stabil walau frame lambat)
static void springStep(float& x, float& v, float target, float dt, float k, float c) {
  while (dt > 0) {
    float h = dt > 0.008f ? 0.008f : dt;
    v += (k * (target - x) - c * v) * h;
    x += v * h;
    dt -= h;
  }
}

// ============================== TRANSISI LAYAR ===============================
// Layar lama & baru dirender ke snapBuf / snapBuf2, lalu tiap frame hanya digabung (murah):
//   ZOOM_OPEN  : jendela aplikasi membesar dari ikon di beranda
//   ZOOM_CLOSE : jendela aplikasi mengecil kembali ke ikonnya
//   SLIDE_FWD / SLIDE_BACK : masuk / keluar sub-layar dengan paralaks + bayangan tepi
//   FADE       : pudar silang (layar lain)
static const uint8_t TR_NONE = 0, TR_ZOOM_OPEN = 1, TR_ZOOM_CLOSE = 2, TR_SLIDE_FWD = 3, TR_SLIDE_BACK = 4, TR_FADE = 5;
static bool     trActive = false;
static uint8_t  trKind = TR_NONE;
static uint32_t trT0 = 0;
static uint16_t trDur = 0;
static float    trIcx = 120, trIcy = 160;

static inline bool trReady() { return UI_SMOOTH && snapBuf && snapBuf2; }
static void trBegin(uint8_t kind, uint16_t dur) { trKind = kind; trDur = dur; trT0 = millis(); trActive = true; }

static void trZoom(const u16* base, const u16* win, float p) {
  memcpy(fb, base, FB_BYTES);
  dimRows(0, SCR_H, (uint8_t)(110.0f * p));
  float L = trIcx - 20, T = trIcy - 20, R = trIcx + 20, B = trIcy + 20;
  int X0 = (int)(L + (0 - L) * p + 0.5f),           Y0 = (int)(T + (0 - T) * p + 0.5f);
  int X1 = (int)(R + (SCR_W - R) * p + 0.5f),       Y1 = (int)(B + (SCR_H - B) * p + 0.5f);
  int rad = (int)(12.0f * (1.0f - p) + 0.5f);
  float wa = p * 5.0f; if (wa > 1) wa = 1;
  blitScaled(win, X0, Y0, X1, Y1, rad, (uint8_t)(255.0f * wa));
}
static void trSlide(const u16* A, const u16* B, float p) {      // B masuk dari kanan, A bergeser pelan di belakangnya
  int o = (int)(SCR_W * (1.0f - p) + 0.5f); if (o < 0) o = 0; if (o > SCR_W) o = SCR_W;
  int s = (int)((SCR_W - o) * 0.30f);
  uint32_t k = (uint32_t)(255 - (int)(70.0f * p)) * 32 / 255;
  for (int y = 0; y < SCR_H; y++) {
    u16* d = fb + y * SCR_W;
    if (o > 0)      { memcpy(d, A + y * SCR_W + s, (size_t)o * 2); if (k < 32) dimSpan(d, o, k); }
    if (o < SCR_W)  memcpy(d + o, B + y * SCR_W, (size_t)(SCR_W - o) * 2);
  }
  if (o < SCR_W - 2) {                                           // bayangan lembut di tepi kiri layar yang masuk
    for (int dx = 1; dx <= 10; dx++) {
      int x = o - dx; if (x < 0) break;
      uint8_t a = (uint8_t)((11 - dx) * 7);
      for (int y = 0; y < SCR_H; y++) { u16* q = fb + y * SCR_W + x; *q = mix(0x0000, *q, a); }
    }
  }
}
static void trFade(const u16* A, const u16* B, float p) {
  uint8_t a = (uint8_t)(255.0f * clamp01(p));
  for (int i = 0; i < SCR_W * SCR_H; i++) fb[i] = mix(B[i], A[i], a);
}
// gambar satu frame transisi ke fb; false = transisi selesai (frame terakhir = layar baru)
static bool trFrame(uint32_t now) {
  uint32_t el = now - trT0;
  bool more = el < trDur;
  float t = more ? (float)el / (float)trDur : 1.0f;
  float e = easeUI(t);
  switch (trKind) {
    case TR_ZOOM_OPEN:  trZoom(snapBuf, snapBuf2, e); break;
    case TR_ZOOM_CLOSE: trZoom(snapBuf2, snapBuf, 1.0f - e); break;
    case TR_SLIDE_FWD:  trSlide(snapBuf, snapBuf2, e); break;
    case TR_SLIDE_BACK: trSlide(snapBuf2, snapBuf, 1.0f - e); break;
    default:            trFade(snapBuf, snapBuf2, smooth(t)); break;
  }
  return more;
}


