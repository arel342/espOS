static Btn& addBtn(int x, int y, int w, int h, int code, uint8_t style, const char* label = "", const char* sub = "",
                   const AIcon* icon = nullptr, u16 ink = 0xFFFF) {
  if (nbtn >= 56) nbtn = 55;
  Btn& b = btns[nbtn++];
  b.x = x; b.y = y; b.w = w; b.h = h; b.code = code; b.style = style; b.icon = icon; b.ink = ink;
  strncpy(b.label, label, sizeof(b.label) - 1); b.label[sizeof(b.label) - 1] = 0;
  strncpy(b.sub, sub, sizeof(b.sub) - 1);       b.sub[sizeof(b.sub) - 1] = 0;
  return b;
}
static int hitBtn(int x, int y) {
  for (int i = nbtn - 1; i >= 0; i--) {
    const Btn& b = btns[i];
    if (x >= b.x - 2 && x < b.x + b.w + 2 && y >= b.y - 2 && y < b.y + b.h + 2) return i;
  }
  return -1;
}

// riak sentuhan: lingkaran membesar dari titik sentuh, terpotong mengikuti bentuk tombol
static void drawRipple(int idx, float x, float y, float w, float h, float rad) {
  if (!rip.on || rip.bi != idx) return;
  uint32_t el = millis() - rip.t0;
  if (el > 420) return;
  float t = el / 420.0f;
  float R = 8.0f + sqrtf(w * w + h * h) * easeOut(t);
  float amax = 70.0f * (1.0f - t);
  float cx = x + w * 0.5f, cy = y + h * 0.5f, hw = w * 0.5f, hh = h * 0.5f;
  float r = rad; if (r > hw) r = hw; if (r > hh) r = hh;
  float ax = hw - r, ay = hh - r;
  int xa = (int)fmaxf(x, rip.x - R), xb = (int)fminf(x + w, rip.x + R) + 1;
  int ya = (int)fmaxf(y, rip.y - R), yb = (int)fminf(y + h, rip.y + R) + 1;
  float R2 = R * R;
  for (int j = ya; j < yb; j++) for (int i = xa; i < xb; i++) {
    float dx = i + 0.5f - rip.x, dy = j + 0.5f - rip.y, d2 = dx * dx + dy * dy;
    if (d2 > R2) continue;
    float cv = rrCov(i + 0.5f, j + 0.5f, cx, cy, ax, ay, r, 0);
    if (cv <= 0) continue;
    float edge = R - sqrtf(d2); float e = edge > 3 ? 1.0f : edge / 3.0f;
    px(i, j, 0xFFFF, (uint8_t)(amax * cv * e));
  }
}

// pv = pegas tekan (0 lepas, 1 tertekan, bisa sedikit <0 / >1 saat memantul)
static void drawBtn(const Btn& b, bool pr, float pv, int idx) {
  (void)pr;
  const Theme& t = THEMES[curTheme];
  float x = b.x, y = b.y, w = b.w, h = b.h;
  float pc = clamp01(pv);
  switch (b.style) {
    case B_HIDDEN: return;
    case B_APP: {
      const App& a = APPS[b.code];
      float cx = x + w / 2, cy = y + 22;
      float s = 40.0f - 7.0f * pv;                                   // mengecil saat ditekan, memantul saat dilepas
      if (pc > 0.03f) glow((int)cx, (int)cy, 36, a.ink, (uint8_t)(48.0f * pc));
      u16 tile = pc > 0.01f ? mix(H(0xFFFFFF), a.tile, (uint8_t)(34.0f * pc)) : a.tile;
      u16 edge = pc > 0.01f ? mix(a.ink, a.edge, (uint8_t)(110.0f * pc)) : a.edge;
      rrect(cx - s / 2, cy - s / 2, s, s, 12, tile);
      rrect(cx - s / 2 + 0.5f, cy - s / 2 + 0.5f, s - 1, s - 1, 11.5f, edge, 255, 1.0f);
      drawIcon(*a.ic, cx, cy, a.ink, (uint8_t)(255.0f - 40.0f * pc));
      drawText(F9, (int)cx, (int)cy + 33, a.name, pc > 0.01f ? mix(COL_WHITE, COL_LABEL, (uint8_t)(255.0f * pc)) : COL_LABEL, 255, 1);
      if (pc > 0.1f) disc(cx, cy + 41, 1.7f, a.ink, (uint8_t)(255.0f * pc));   // titik penanda "akan dibuka"
      return;
    }
    case B_ROW: {
      rrect(x, y, w, h, 12, H(0xFFFFFF), (uint8_t)(14.0f + 20.0f * pc));
      rrect(x + 0.5f, y + 0.5f, w - 1, h - 1, 11.5f, H(0xFFFFFF), (uint8_t)(24.0f + 30.0f * pc), 1.0f);
      drawRipple(idx, x, y, w, h, 12);
      if (pc > 0.05f) rrect(x + 2.5f, y + h * 0.5f - 8.0f * pc, 2.6f, 16.0f * pc, 1.3f, t.accent, (uint8_t)(230.0f * pc));   // penanda aksen di kiri
      int tx0 = (int)x + 14;
      if (b.icon) {
        rrect(x + 8, y + (h - 30) / 2, 30, 30, 9, H(0x1B222C));
        drawIcon(*b.icon, x + 23, y + h / 2, b.ink);
        tx0 = (int)x + 48;
      }
      bool two = b.sub[0] != 0 && h >= 30;               // baris pendek: keterangan di kanan, satu baris
      drawText(F10, tx0, (int)(y + h / 2) + (two ? -2 : 4), b.label, COL_TEXT);
      if (two) drawText(F8, tx0, (int)(y + h / 2) + 12, b.sub, COL_MUTED);
      else if (b.sub[0]) drawText(F8, (int)(x + w - 26), (int)(y + h / 2) + 4, b.sub, COL_MUTED, 255, 2);
      drawIcon(IC_CHEV_R, x + w - 14 + 3.0f * pc, y + h / 2, pc > 0.3f ? t.accent : COL_MUTED2);   // panah bergeser = "akan dibuka"
      return;
    }
    default: break;
  }
  // tombol berisi (kalkulator, keyboard, dll)
  u16 fill, ink = COL_WHITE;
  switch (b.style) {
    case B_KEY:  fill = H(0x1B222C); break;
    case B_KEY2: fill = H(0x303946); break;
    case B_OP:   fill = mix(t.accent, H(0x0F141B), 70); ink = t.accent; break;
    case B_EQ:   fill = t.accent; ink = H(0x07201C); break;
    case B_KB:   fill = H(0x232B36); break;
    default:     fill = H(0x363F4D); break;   // B_KBSP
  }
  if (pc > 0.01f) fill = mix(H(0xFFFFFF), fill, (uint8_t)(60.0f * pc));
  float rad = h * 0.5f; if (rad > 11) rad = 11;
  float in = 1.4f * pv;                                              // tombol mengecil sedikit saat ditekan
  rrect(x + in, y + in, w - 2 * in, h - 2 * in, rad, fill);
  drawRipple(idx, x, y, w, h, rad);
  bool kb = (b.style == B_KB || b.style == B_KBSP);
  if (b.icon) drawIcon(*b.icon, x + w * 0.5f, y + h * 0.5f, ink);
  else if (b.label[0]) drawText(kb ? F10 : B13, (int)(x + w * 0.5f), (int)(y + h * 0.5f) + (kb ? 4 : 5), b.label, ink, 255, 1);
}

// ============================== KALKULATOR ===================================
static char   calcDisp[24] = "0";
static char   calcExpr[28] = "";
static double calcAcc = 0;
static char   calcOp = 0;
static bool   calcFresh = true, calcErr = false;

static void calcReset() { strcpy(calcDisp, "0"); calcExpr[0] = 0; calcAcc = 0; calcOp = 0; calcFresh = true; calcErr = false; }
static double calcVal() { return atof(calcDisp); }
static void calcSetNum(double v) {
  if (isnan(v) || isinf(v)) { strcpy(calcDisp, "Error"); calcErr = true; return; }
  char buf[32]; snprintf(buf, sizeof(buf), "%.9g", v);
  if (strlen(buf) > 13) snprintf(buf, sizeof(buf), "%.6g", v);
  if (!strcmp(buf, "-0")) strcpy(buf, "0");
  strncpy(calcDisp, buf, sizeof(calcDisp) - 1); calcDisp[sizeof(calcDisp) - 1] = 0;
}
static double calcApply(double a, char op, double b) {
  switch (op) { case '+': return a + b; case '-': return a - b; case '*': return a * b; case '/': return b == 0 ? NAN : a / b; }
  return b;
}
static void calcPress(int code) {
  if (code == 'C') { calcReset(); return; }
  if (calcErr) return;
  if (code >= '0' && code <= '9') {
    if (calcFresh) { strcpy(calcDisp, "0"); calcFresh = false; }
    int n = strlen(calcDisp);
    if (!strcmp(calcDisp, "0")) { calcDisp[0] = code; calcDisp[1] = 0; }
    else if (!strcmp(calcDisp, "-0")) { calcDisp[1] = code; calcDisp[2] = 0; }
    else if (n < 12) { calcDisp[n] = code; calcDisp[n + 1] = 0; }
  } else if (code == '.') {
    if (calcFresh) { strcpy(calcDisp, "0"); calcFresh = false; }
    if (!strchr(calcDisp, '.') && strlen(calcDisp) < 12) strcat(calcDisp, ".");
  } else if (code == 'n') {
    if (strcmp(calcDisp, "0")) {
      if (calcDisp[0] == '-') memmove(calcDisp, calcDisp + 1, strlen(calcDisp));
      else { memmove(calcDisp + 1, calcDisp, strlen(calcDisp) + 1); calcDisp[0] = '-'; }
    }
  } else if (code == '%') {
    calcSetNum(calcVal() / 100.0); calcFresh = true;
  } else if (code == '=') {
    if (calcOp) { double r = calcApply(calcAcc, calcOp, calcVal()); calcExpr[0] = 0; calcOp = 0; calcSetNum(r); calcFresh = true; }
  } else {                                   // + - * /
    if (calcOp && !calcFresh) { double r = calcApply(calcAcc, calcOp, calcVal()); calcSetNum(r); if (calcErr) return; }
    calcAcc = calcVal(); calcOp = (char)code; calcFresh = true;
    snprintf(calcExpr, sizeof(calcExpr), "%s %c", calcDisp, code == '*' ? 'x' : (char)code);
  }
}

