// gelembung huruf di atas tombol keyboard yang sedang ditekan (seperti keyboard HP)
static void drawKeyPopup() {
  if (pressedId < 0 || pressedId >= nbtn) return;
  const Btn& b = btns[pressedId];
  if (b.style != B_KB || !b.label[0]) return;
  float w = b.w + 14, hh = 40;
