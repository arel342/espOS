static u16* allocFrame(bool mustHave) {
  // Selalu coba PSRAM dulu — N16R8 punya 8 MB, lebih dari cukup untuk 3 FB × 150 KB
  u16* p = (u16*)PSRAM_MALLOC(FB_BYTES);
  if (p) { memset(p, 0, FB_BYTES); return p; }

  // Fallback ke internal RAM hanya jika PSRAM gagal (misal PSRAM belum diaktifkan di Arduino IDE)
  if (mustHave) {
    p = (u16*)heap_caps_malloc(FB_BYTES, MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    if (!p) p = (u16*)heap_caps_malloc(FB_BYTES, MALLOC_CAP_8BIT);
    if (p) memset(p, 0, FB_BYTES);
  }
  return p;
}

