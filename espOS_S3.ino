// ============================== KUNCI LAYAR: TAMPILAN PIN & POLA =============
static const int PIN_X0 = 16, PIN_KW = 64, PIN_KGX = 8, PIN_Y0 = 134, PIN_KH = 32, PIN_KGY = 5;
static const int PAT_CX[3] = {60, 120, 180}, PAT_CY[3] = {136, 194, 252}, PAT_HIT = 26;

static int pinKeyAt(int x, int y) {
  for (int k = 0; k < 12; k++) {
    int kx = PIN_X0 + (k % 3) * (PIN_KW + PIN_KGX), ky = PIN_Y0 + (k / 3) * (PIN_KH + PIN_KGY);
    if (x >= kx && x < kx + PIN_KW && y >= ky && y < ky + PIN_KH) return k;
  }
  return -1;
}
static int patDotAt(int x, int y) {
  for (int n = 0; n < 9; n++) {
    int dx = x - PAT_CX[n % 3], dy = y - PAT_CY[n / 3];
    if (dx * dx + dy * dy <= PAT_HIT * PAT_HIT) return n;
  }
  return -1;
}
static void thickLine(float x0, float y0, float x1, float y1, float r, u16 c) {
  float dx = x1 - x0, dy = y1 - y0, len = sqrtf(dx * dx + dy * dy);
  int n = (int)len + 1;
  for (int i = 0; i <= n; i++) { float f = (float)i / n; disc(x0 + dx * f, y0 + dy * f, r, c); }
}

// al = transparansi seluruh elemen, yo = geser vertikal (untuk animasi masuk)
static void drawCredUI(uint8_t al, int yo) {
  const Theme& t = THEMES[curTheme];
  int kind = credKind();
  uint32_t now = millis();
  const char* ttl;
  if (kind == 1) ttl = credPurpose < 2 ? "Masukkan PIN" : (credPurpose == 2 ? "Buat PIN baru" : "Ulangi PIN");
  else           ttl = credPurpose < 2 ? "Gambar pola" : (credPurpose == 2 ? "Buat pola baru" : "Ulangi pola");
  drawText(B13, 120, 80 + yo, ttl, COL_TEXT, al, 1);
  const char* msg = credMsg; u16 mc = credMsgErr ? H(0xFF7A7A) : t.accent;
  if (!msg[0]) {
    mc = COL_MUTED;
    if (credPurpose == 2) msg = kind == 1 ? "4 sampai 8 angka" : "Hubungkan minimal 4 titik";
    else if (credPurpose == 3) msg = "Ulangi untuk konfirmasi";
  }
  drawText(F9, 120, 100 + yo, msg, mc, al, 1);

  if (kind == 1) {
    int slots = credLen > 4 ? credLen : 4;
    float shake = 0;
    if (credShakeT && now - credShakeT < 450) { float k = (now - credShakeT) / 450.0f; shake = 9.0f * sinf(k * 28.0f) * (1.0f - k); }
    float x0 = 120.0f - (slots - 1) * 10.0f + shake, y = 118.0f + yo;
    for (int i = 0; i < slots; i++) {
      float cx = x0 + i * 20.0f;
      if (i < credLen) {
        float r = 5.2f;
        if (i == credLen - 1 && credPopT && now - credPopT < 160) r = 2.0f + 3.2f * easeOut((now - credPopT) / 160.0f);
        disc(cx, y, r, credMsgErr && now - credMsgT < 600 ? H(0xFF7A7A) : t.accent, al);
      } else disc(cx, y, 3.0f, COL_MUTED2, (uint8_t)(al * 140 / 255));
    }
    for (int k = 0; k < 12; k++) {
      float x = PIN_X0 + (k % 3) * (PIN_KW + PIN_KGX), yk = PIN_Y0 + (k / 3) * (PIN_KH + PIN_KGY) + yo;
      float pv = credSp[k], pc = clamp01(pv);
      u16 fill = (k == 11) ? t.accent : (k == 9 ? H(0x303946) : H(0x1B222C));
      if (pc > 0.01f) fill = mix(H(0xFFFFFF), fill, (uint8_t)(60.0f * pc));
      float in = 1.6f * pv;
      rrect(x + in, yk + in, PIN_KW - 2 * in, PIN_KH - 2 * in, 12, fill, al);
      if (k == 9) drawIcon(IC_BKSP, x + PIN_KW / 2, yk + PIN_KH / 2, COL_WHITE, al);
      else if (k == 11) drawText(B13, (int)x + PIN_KW / 2, (int)yk + 21, "OK", H(0x07201C), al, 1);
      else { char d[2] = { (char)(k == 10 ? '0' : '1' + k), 0 }; drawText(B13, (int)x + PIN_KW / 2, (int)yk + 21, d, COL_WHITE, al, 1); }
    }
  } else {
    u16 col = patErr ? H(0xFF6B6B) : t.accent;
    for (int i = 0; i + 1 < patLen; i++)
      thickLine(PAT_CX[patSeq[i] % 3], PAT_CY[patSeq[i] / 3] + yo, PAT_CX[patSeq[i + 1] % 3], PAT_CY[patSeq[i + 1] / 3] + yo, 1.9f, col);
    if (patDrag && patLen > 0 && !patErr)
      thickLine(PAT_CX[patSeq[patLen - 1] % 3], PAT_CY[patSeq[patLen - 1] / 3] + yo, patFx, patFy + yo, 1.9f, col);
    for (int n = 0; n < 9; n++) {
      float cx = PAT_CX[n % 3], cy = PAT_CY[n / 3] + yo;
      bool vis = false; for (int i = 0; i < patLen; i++) if (patSeq[i] == n) vis = true;
      if (vis) { disc(cx, cy, 8.0f, col, al); arcLine(cx, cy, 17.0f, 1.6f, 0, 359.9f, col, (uint8_t)(al * 130 / 255)); }
      else disc(cx, cy, 5.0f, COL_LABEL, (uint8_t)(al * 170 / 255));
    }
  }
  if (locked) drawText(F10, 120, 305, "Batal", COL_LABEL, al, 1);
}

