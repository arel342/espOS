// ============================== WARNA ========================================
constexpr u16 H(uint32_t c) { return ((c >> 8) & 0xF800) | ((c >> 5) & 0x07E0) | ((c >> 3) & 0x001F); }

static inline u16 mix(u16 fg, u16 bg, uint8_t a) {       // alpha blend RGB565
  if (a == 0) return bg;
  if (a == 255) return fg;
  uint32_t f = fg, b = bg;
  f = (f | (f << 16)) & 0x07E0F81FUL;
  b = (b | (b << 16)) & 0x07E0F81FUL;
  uint32_t al = ((uint32_t)a * 33) >> 8;
  uint32_t r = ((((f - b) * al) >> 5) + b) & 0x07E0F81FUL;
  return (u16)((r >> 16) | r);
}

