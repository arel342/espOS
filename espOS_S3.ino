static void drawScene();   // deklarasi maju (dipakai untuk cuplikan transisi)

static int appOfScreen(Screen s) {            // layar ini milik aplikasi nomor berapa di beranda (-1 = bukan)
  switch (s) {
    case SC_FILES: case SC_FILEVIEW: return 0;
    case SC_CALC: return 1;
    case SC_NOTES: case SC_NOTEEDIT: return 2;
    case SC_STOPWATCH: return 3;
    case SC_DINO: return 6;
    case SC_PONG: return 7;
    case SC_FLAPPY: return 8;
    case SC_SETTINGS: case SC_SYSINFO: case SC_SETTIME: case SC_OTA: case SC_ABOUT: case SC_WIFI: case SC_WIFIPASS:
    case SC_LOCKSET: case SC_PINPAD: case SC_PATTERN: return 5;
    default: return -1;
  }
}
static int screenDepth(Screen s) {            // kedalaman layar di dalam aplikasi (untuk arah geser)
  switch (s) {
    case SC_HOME: return 0;
    case SC_NOTEEDIT: case SC_FILEVIEW: case SC_SYSINFO: case SC_SETTIME: case SC_OTA: case SC_ABOUT: case SC_LOCKSET: case SC_WIFIPASS: return 2;
    case SC_PINPAD: case SC_PATTERN: return 3;
    default: return 1;
  }
}

static void goScreen(Screen s) {
  Screen old = screen;
  uint8_t kind = TR_NONE; uint16_t dur = 0; int iconApp = -1;
  if (trActive) trActive = false;
  if (trReady() && s != old && !locked && !sleeping && !sheetOpen && !cpOpen && cpAnim < 0.02f) {
    int ao = appOfScreen(old), an = appOfScreen(s);
    kind = TR_FADE; dur = 170;
    if (old == SC_HOME && an >= 0)         { kind = TR_ZOOM_OPEN;  dur = 340; iconApp = an; }
    else if (s == SC_HOME && ao >= 0)      { kind = TR_ZOOM_CLOSE; dur = 300; iconApp = ao; }
    else if (ao >= 0 && ao == an) {
      int d0 = screenDepth(old), d1 = screenDepth(s);
      if (d1 > d0) { kind = TR_SLIDE_FWD; dur = 270; } else if (d1 < d0) { kind = TR_SLIDE_BACK; dur = 250; }
    }
    rip.on = false;
    u16* keep = fb; fb = snapBuf; drawScene(); fb = keep;       // cuplikan layar LAMA (langsung ke snapBuf)
  }
  if (s == SC_HOME) { int aoo = appOfScreen(old); if (aoo >= 0) { homePage = aoo / 6; homePos = (float)(homePage * 240); homeV = 0; homeSpring = false; } }
  screen = s; sheetOpen = false;
  if (s == SC_FILES) refreshFiles();
  if (s == SC_PINPAD || s == SC_PATTERN) credReset();
  buildButtons(); dirty = true;
  if (kind != TR_NONE) {
    u16* keep = fb; fb = snapBuf2; drawScene(); fb = keep;      // cuplikan layar BARU
    if (iconApp >= 0) { int ii = iconApp % 6; trIcx = COLX[ii % 3]; trIcy = ROWY[ii / 3]; }
    trBegin(kind, dur);
  }
}
static void pushRecent(int app) {
  int j = 0; int8_t tmp[4] = {-1, -1, -1, -1}; tmp[j++] = app;
  for (int i = 0; i < 4 && j < 4; i++) if (recents[i] >= 0 && recents[i] != app) tmp[j++] = recents[i];
  for (int i = 0; i < 4; i++) recents[i] = tmp[i];
}
static void openApp(int a) {
  if (a == 4) { sheetOpen = true; lastAnimMs = millis(); dirty = true; return; }
  pushRecent(a);
  switch (a) {
    case 0: fPage = 0; goScreen(SC_FILES); break;
    case 1: goScreen(SC_CALC); break;
    case 2: goScreen(SC_NOTES); break;
    case 3: goScreen(SC_STOPWATCH); break;
    case 5: goScreen(SC_SETTINGS); break;
    case 6: gameStart(SC_DINO);   goScreen(SC_DINO);   break;
    case 7: gameStart(SC_PONG);   goScreen(SC_PONG);   break;
    case 8: gameStart(SC_FLAPPY); goScreen(SC_FLAPPY); break;
  }
}

