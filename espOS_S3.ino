static const char* HARI[7]   = {"Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"};
static const char* BULAN[12] = {"Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"};
static const uint8_t HARI_BULAN[12] = {31,28,31,30,31,30,31,31,30,31,30,31};
static uint32_t lastMinuteMs = 0;

static int daysInMonth(int mo) {
  if (mo == 1) { bool leap = (clk_yy % 4 == 0 && clk_yy % 100 != 0) || (clk_yy % 400 == 0); return leap ? 29 : 28; }
  return HARI_BULAN[mo];
}
static bool tickClock(uint32_t now) {
  bool ch = false;
  while (now - lastMinuteMs >= 60000UL) {
    lastMinuteMs += 60000UL; ch = true;
    if (++clk_mm >= 60) { clk_mm = 0;
      if (++clk_hh >= 24) { clk_hh = 0; clk_wd = (clk_wd + 1) % 7;
        if (++clk_dd > daysInMonth(clk_mo)) { clk_dd = 1; if (++clk_mo >= 12) { clk_mo = 0; clk_yy++; } } } }
  }
  return ch;
}

