static void drawLock() {
  int sh = lockShift;
  copyBG();
  if (sh > 0 && lockSnapOK && snapBuf2 && lkType == 0) {   // tanpa kunci: layar di baliknya muncul perlahan saat digeser
    uint8_t ha = (uint8_t)(sh >= 170 ? 255 : sh * 255 / 170);
    for (int i = 0; i < SCR_W * SCR_H; i++) fb[i] = mix(snapBuf2[i], fb[i], ha);
  }
  drawStatusBar();
  drawTopHint();
  if (lockAuth) {                                        // minta PIN / pola (isi layar tidak pernah terlihat)
    float e = easeOut(clamp01((millis() - lockAuthT) / 240.0f));
    drawCredUI((uint8_t)(255.0f * e), (int)(18.0f * (1.0f - e)));
    return;
  }
  uint8_t al = (sh >= 140) ? 0 : (uint8_t)(255 - sh * 255 / 140);
  char b[44];
  drawText(F9, 120, 96 - sh, "Terkunci", COL_MUTED, al, 1);
  snprintf(b, sizeof(b), "%02d:%02d", clk_hh, clk_mm);
  drawText(CLK, 120, 150 - sh, b, COL_WHITE, al, 1);
  snprintf(b, sizeof(b), "%s, %d %s %d", HARI[clk_wd], clk_dd, BULAN[clk_mo], clk_yy);
  drawText(B13, 120, 180 - sh, b, COL_LABEL, al, 1);
  int bob = (sh == 0 && !lockDrag && !lockSpring) ? (int)(2.5f * sinf(millis() * 0.005f)) : 0;
  drawText(F9, 120, 284 - sh / 2 + bob, lkType ? "Geser ke atas untuk membuka kunci" : "Geser ke atas untuk membuka", COL_MUTED, al, 1);
  float pw = 60.0f + (lockDrag ? (sh > 100 ? 100 : sh) * 0.5f : 0.0f);
  rrect(120.0f - pw / 2, 298 - sh / 2 + bob, pw, 4, 2, COL_LABEL, al);
}

