static char noteText[184]; static int noteLen = 0, noteSlot = 0;
static int  kbLayer = 0;                        // 0 huruf kecil, 1 huruf besar, 2 simbol

static void notePath(int n, char* out) { snprintf(out, 24, "/catatan%d.txt", n + 1); }
static void loadNote(int n) {
  noteLen = 0; noteText[0] = 0;
  if (!fsOK) return;
  char path[24]; notePath(n, path);
  File f = LittleFS.open(path, "r");
  if (f) { noteLen = f.readBytes(noteText, sizeof(noteText) - 1); noteText[noteLen] = 0; f.close(); }
}
static void saveNote() {
  if (!fsOK) return;
  char path[24]; notePath(noteSlot, path);
  if (noteLen == 0) { LittleFS.remove(path); return; }
  File f = LittleFS.open(path, "w");
  if (f) { f.write((const uint8_t*)noteText, noteLen); f.close(); }
}
static void notePreview(int n, char* out, int maxc) {
  out[0] = 0;
  if (!fsOK) { strncpy(out, "Penyimpanan tidak tersedia", maxc); out[maxc] = 0; return; }
  char path[24]; notePath(n, path);
  File f = LittleFS.open(path, "r");
  if (!f) { strcpy(out, "Kosong"); return; }
  int i = 0; while (i < maxc && f.available()) { int c = f.read(); if (c == '\n' || c == '\r') break; out[i++] = (char)c; }
  out[i] = 0; f.close();
  if (!i) strcpy(out, "Kosong");
}

static char fNames[24][24]; static uint32_t fSizes[24]; static int fCount = 0, fPage = 0;
static char viewName[24], viewBuf[420]; static int viewLen = 0; static bool viewBinary = false;

static void refreshFiles() {
  fCount = 0;
  if (!fsOK) return;
  File root = LittleFS.open("/");
  if (!root) return;
  File f = root.openNextFile();
  while (f && fCount < 24) {
    if (!f.isDirectory()) {
      const char* nm = f.name(); if (nm[0] == '/') nm++;
      strncpy(fNames[fCount], nm, 23); fNames[fCount][23] = 0;
      fSizes[fCount] = f.size(); fCount++;
    }
    f = root.openNextFile();
  }
  if (fPage * 4 >= fCount) fPage = 0;
}
static void openFileView(const char* name) {
  strncpy(viewName, name, 23); viewName[23] = 0;
  viewLen = 0; viewBinary = false; viewBuf[0] = 0;
  char path[32]; snprintf(path, sizeof(path), "/%s", name);
  File f = LittleFS.open(path, "r");
  if (!f) return;
  viewLen = f.readBytes(viewBuf, sizeof(viewBuf) - 1); viewBuf[viewLen] = 0; f.close();
  for (int i = 0; i < viewLen; i++) { uint8_t c = viewBuf[i]; if ((c < 32 && c != '\n' && c != '\r' && c != '\t') || c > 126) { viewBinary = true; break; } }
}
static void fmtSize(uint32_t b, char* out) {
  if (b < 1024) snprintf(out, 16, "%u B", (unsigned)b);
  else if (b < 1024 * 1024) snprintf(out, 16, "%.1f KB", b / 1024.0f);
  else snprintf(out, 16, "%.2f MB", b / 1048576.0f);
}

