// ikon vektor kecil untuk tile (bg = warna isi tile, dipakai untuk "melubangi" bentuk)
static void cpIcon(int id, float cx, float cy, u16 c, u16 bg) {
  switch (id) {
    case 0: {                                           // Wi-Fi
      float by = cy + 8;
      arcLine(cx, by, 5.0f,  2.2f, 225, 315, c, 255);
      arcLine(cx, by, 10.0f, 2.2f, 225, 315, c, 255);
      arcLine(cx, by, 15.0f, 2.2f, 225, 315, c, 255);
      disc(cx, by, 2.0f, c);
      break;
    }
    case 1:                                             // senter
      rrect(cx - 7, cy - 14, 14, 7, 2.5f, c);
      rrect(cx - 4.5f, cy - 8, 9, 21, 3, c);
      disc(cx, cy + 1, 1.8f, bg);
      break;
    case 2:                                             // kunci
      ringS(cx, cy - 4, 5.5f, 2.2f, c);
      rrect(cx - 8, cy - 2, 16, 13, 3, c);
      disc(cx, cy + 4, 1.8f, bg);
      break;
    case 3:                                             // tidur (bulan sabit)
      disc(cx, cy, 10, c);
      disc(cx + 5, cy - 4, 8.5f, bg);
      break;
    case 4:                                             // deep sleep (ikon power)
      ringS(cx, cy + 1, 9.5f, 2.4f, c);
      rrect(cx - 4, cy - 13, 8, 10, 0, bg);
      rrect(cx - 1.3f, cy - 12, 2.6f, 12, 1.3f, c);
      break;
    default: drawIcon(IC_GEAR, cx, cy, c); break;       // setelan
  }
}

static void drawTile(int id, int x, int y, bool on, float pv, float hold, const char* label, const char* sub, u16 onCol, u16 onInk) {
  float pc = clamp01(pv);
  u16 fill = on ? onCol : H(0x1B222C);
  if (pc > 0.01f) fill = mix(H(0xFFFFFF), fill, (uint8_t)(55.0f * pc));
  u16 ink = on ? onInk : COL_TEXT;
  float in = 3.0f * pv;                                  // mengecil saat ditekan, memantul saat dilepas
  rrect(x + in, y + in, 68 - 2 * in, 64 - 2 * in, 16 - in * 0.5f, fill);
  if (!on) rrect(x + 0.5f + in, y + 0.5f + in, 67 - 2 * in, 63 - 2 * in, 15.5f - in * 0.5f, H(0xFFFFFF), 22, 1.0f);
  cpIcon(id, x + 34, y + 22, ink, fill);
  const AFont& lf = (textWidth(B9, label) <= 62) ? B9 : F9;
  drawText(lf, x + 34, y + (sub[0] ? 46 : 52), label, ink, 255, 1);
  if (sub[0]) drawText(F8, x + 34, y + 59, sub, on ? ink : COL_MUTED, 255, 1);
  if (hold > 0.02f) arcLine(x + 34, y + 32, 29.0f, 2.6f, 270.0f, 270.0f + 359.0f * hold, ink, 230);   // cincin progres "tahan"
}

static int cpHitTile(int x, int y) {                    // koordinat panel terbuka penuh
  static const int TX[3] = {12, 86, 160}, TYr[2] = {100, 170};
  for (int r = 0; r < 2; r++) for (int c = 0; c < 3; c++)
    if (x >= TX[c] && x < TX[c] + 68 && y >= TYr[r] && y < TYr[r] + 64) return r * 3 + c;
  return -1;
}

