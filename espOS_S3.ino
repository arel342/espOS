static void drawThemeDisc(float cx, float cy, float r, const Theme& t) {
  int x0 = (int)(cx - r - 1), x1 = (int)(cx + r + 2), y0 = (int)(cy - r - 1), y1 = (int)(cy + r + 2);
  float acx = cx + r * 0.95f, acy = cy + r * 0.25f, ar = r * 1.15f;
  for (int j = y0; j < y1; j++) for (int i = x0; i < x1; i++) {
    float dx = i + 0.5f - cx, dy = j + 0.5f - cy, d = sqrtf(dx * dx + dy * dy);
    float cov = r - d + 0.5f; if (cov <= 0) continue; if (cov > 1) cov = 1;
    float lit = 0.30f * (1.0f - d / r) * (1.0f - d / r) + 0.06f;
    float ex = i + 0.5f - acx, ey = j + 0.5f - acy;
    float s = fabsf(sqrtf(ex * ex + ey * ey) - ar) / (r * 0.13f);
    float streak = s < 1 ? (1 - s) * 0.75f : 0;
    float k = lit + streak; if (k > 1) k = 1;
    px(i, j, mix(t.discHi, t.discBase, (uint8_t)(k * 255)), (uint8_t)(cov * 255));
  }
}

