static void drawHomePages() {
  const Theme& t = THEMES[curTheme];
  int p0 = (int)floorf(homePos / (float)SCR_W);
  for (int p = p0; p <= p0 + 1; p++) {
    if (p < 0 || p >= HOME_PAGES) continue;
    int ox = (int)floorf(p * (float)SCR_W - homePos + 0.5f);
    for (int i = 0; i < 6; i++) {
      int app = p * 6 + i; if (app >= APP_COUNT) break;
      Btn b; memset(&b, 0, sizeof(b));
      b.x = COLX[i % 3] - 34 + ox; b.y = ROWY[i / 3] - 22; b.w = 68; b.h = 62; b.code = app; b.style = B_APP;
      float pv = 0; int idx = -1;
      if (p == homePage && i < nbtn && btns[i].code == app) { pv = bpX[i]; idx = i; }
      if (b.x + b.w < 0 || b.x > SCR_W) continue;
      drawBtn(b, false, pv, idx);
    }
  }
  float prog = homePos / (float)SCR_W;
  for (int i = 0; i < HOME_PAGES; i++) {
    float near = 1.0f - fabsf(prog - (float)i); if (near < 0) near = 0;
    float cx = 120.0f + (i - (HOME_PAGES - 1) * 0.5f) * 14.0f;
    disc(cx, 279, 2.2f + 0.8f * near, near > 0.5f ? t.accent : COL_MUTED2, (uint8_t)(90 + 165 * near));
  }
}

