static uint8_t blLevel = 255;           // kecerahan aktif (0..255)
static int brightPct = 100;             // 10..100

// ---- pengiriman frame ke TFT: sinkron (pushFrame) atau latar belakang (presentFrame) ----
// presentFrame() mengirim fb lewat task di core 0 sambil core 1 menggambar frame berikutnya
// (render & transfer SPI jadi tumpang-tindih -> animasi jauh lebih mulus).
static TaskHandle_t  pushTaskH = nullptr;
static volatile bool pushBusy  = false;
static const u16*    pushSrc   = nullptr;

static void tftBlast(const u16* src) {
  tft.startWrite();
  tft.setAddrWindow(0, 0, SCR_W, SCR_H);
  tft.writePixels((uint16_t*)src, (uint32_t)SCR_W * SCR_H, true, false);
  tft.endWrite();
}
static void pushWorker(void*) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
    tftBlast(pushSrc);
    pushBusy = false;
  }
}
static inline void waitPush() {
  uint32_t t = millis();
  while (pushBusy) { if (millis() - t > 250) { pushBusy = false; break; } delayMicroseconds(120); }
}
static void pushFrame() { waitPush(); tftBlast(fb); }
static void startPushTask() {
  if (fbAlt && !pushTaskH) xTaskCreatePinnedToCore(pushWorker, "tftpush", 4096, nullptr, 2, &pushTaskH, 0);
}
static void presentFrame() {
  if (!pushTaskH || !fbAlt) { pushFrame(); return; }
  waitPush();
  pushSrc = fb; pushBusy = true;
  xTaskNotifyGive(pushTaskH);
  u16* t = fb; fb = fbAlt; fbAlt = t;            // gambar frame berikutnya di buffer yang satunya
}
static void setBacklight(uint8_t v) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWrite(PIN_TFT_BL, v);
#else
  ledcWrite(0, v);
#endif
}
static void fadeBacklight(int from, int to, int ms) {
  uint32_t t0 = millis();
  for (;;) {
    uint32_t dt = millis() - t0; if (dt >= (uint32_t)ms) break;
    setBacklight(from + (to - from) * (int)dt / ms); delay(8);
  }
  setBacklight(to);
}
static void applyBrightness() { blLevel = 25 + (230 * brightPct) / 100; setBacklight(blLevel); }

// ============================== PRIMITIF GAMBAR ==============================
static inline void px(int x, int y, u16 c, uint8_t a) {
  if ((unsigned)x >= SCR_W || (unsigned)y >= SCR_H || a == 0) return;
  u16* p = fb + y * SCR_W + x;
  *p = (a == 255) ? c : mix(c, *p, a);
}
static void fillSolid(u16 c) { for (int i = 0; i < SCR_W * SCR_H; i++) fb[i] = c; }

// cakupan (0..1) satu piksel terhadap kotak membulat (fill atau outline)
static inline float rrCov(float pxc, float pyc, float cx, float cy, float ax, float ay, float r, float stroke) {
  float dx = fabsf(pxc - cx) - ax, dy = fabsf(pyc - cy) - ay;
  float ox = dx > 0 ? dx : 0, oy = dy > 0 ? dy : 0;
  float outside = (ox > 0 && oy > 0) ? sqrtf(ox * ox + oy * oy) : (ox > oy ? ox : oy);
  float inside = dx > dy ? dx : dy; if (inside > 0) inside = 0;
  float sd = outside + inside - r;
  float cov = (stroke <= 0) ? (0.5f - sd) : (0.5f - fabsf(sd + stroke * 0.5f) + stroke * 0.5f);
  return cov <= 0 ? 0 : (cov > 1 ? 1 : cov);
}

// Kotak membulat anti-alias. Bagian tengah tiap baris (jauh dari tepi/sudut) hasilnya sama untuk
// semua kolom, jadi dihitung SEKALI lalu diisi sebagai span -> 4-6x lebih cepat dari versi per-piksel.
static void rrect(float x, float y, float w, float h, float r, u16 c, uint8_t alpha = 255, float stroke = 0) {
  if (alpha == 0 || w <= 0 || h <= 0) return;
  float hw = w * 0.5f, hh = h * 0.5f, cx = x + hw, cy = y + hh;
  if (r > hw) r = hw; if (r > hh) r = hh; if (r < 0) r = 0;
  float ax = hw - r, ay = hh - r;
  int x0 = (int)floorf(x) - 1, x1 = (int)ceilf(x + w) + 1, y0 = (int)floorf(y) - 1, y1 = (int)ceilf(y + h) + 1;
  if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0; if (x1 > SCR_W) x1 = SCR_W; if (y1 > SCR_H) y1 = SCR_H;
  if (x0 >= x1 || y0 >= y1) return;
  float m = ax - (stroke > 0 ? stroke : 0) - 1.5f;         // setengah lebar area tengah yang seragam
  int ls = x1, rs = x1;
  if (m > 1.0f) {
    int a = (int)ceilf(cx - m - 0.5f), b = (int)floorf(cx + m - 0.5f) + 1;
    if (a < x0) a = x0; if (b > x1) b = x1;
    if (b > a) { ls = a; rs = b; }
  }
  for (int j = y0; j < y1; j++) {
    float pyc = j + 0.5f;
    int i = x0;
    for (; i < ls; i++) {
      float cv = rrCov(i + 0.5f, pyc, cx, cy, ax, ay, r, stroke);
      if (cv > 0) px(i, j, c, (uint8_t)(cv * alpha));
    }
    if (rs > ls) {
      uint8_t a8 = (uint8_t)(rrCov(cx, pyc, cx, cy, ax, ay, r, stroke) * alpha);
      if (a8) {
        u16* p = fb + j * SCR_W;
        if (a8 == 255) { for (int k = ls; k < rs; k++) p[k] = c; }
        else           { for (int k = ls; k < rs; k++) p[k] = mix(c, p[k], a8); }
      }
      i = rs;
    }
    for (; i < x1; i++) {
      float cv = rrCov(i + 0.5f, pyc, cx, cy, ax, ay, r, stroke);
      if (cv > 0) px(i, j, c, (uint8_t)(cv * alpha));
    }
  }
}
static inline void disc(float cx, float cy, float r, u16 c, uint8_t a = 255) { rrect(cx - r, cy - r, 2 * r, 2 * r, r, c, a); }
static inline void ringS(float cx, float cy, float r, float t, u16 c, uint8_t a = 255) { rrect(cx - r, cy - r, 2 * r, 2 * r, r, c, a, t); }

static void arcLine(float cx, float cy, float r, float th, float a0, float a1, u16 c, uint8_t alpha) {
  int x0 = (int)(cx - r - th - 2), x1 = (int)(cx + r + th + 2), y0 = (int)(cy - r - th - 2), y1 = (int)(cy + r + th + 2);
  if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0; if (x1 > SCR_W) x1 = SCR_W; if (y1 > SCR_H) y1 = SCR_H;
  for (int j = y0; j < y1; j++) for (int i = x0; i < x1; i++) {
    float dx = i + 0.5f - cx, dy = j + 0.5f - cy;
    float d = sqrtf(dx * dx + dy * dy), e = fabsf(d - r);
    if (e > th * 0.5f + 1) continue;
    float ang = atan2f(dy, dx) * 57.29578f; if (ang < 0) ang += 360;
    float rel = ang - a0; while (rel < 0) rel += 360;
    if (rel > a1 - a0) continue;
    float cov = th * 0.5f + 0.5f - e; if (cov <= 0) continue; if (cov > 1) cov = 1;
    px(i, j, c, (uint8_t)(cov * alpha));
  }
}
static void glow(int cx, int cy, int r, u16 c, uint8_t maxA) {
  int x0 = cx - r, x1 = cx + r, y0 = cy - r, y1 = cy + r, r2 = r * r;
  if (x0 < 0) x0 = 0; if (y0 < 0) y0 = 0; if (x1 > SCR_W) x1 = SCR_W; if (y1 > SCR_H) y1 = SCR_H;
  for (int j = y0; j < y1; j++) for (int i = x0; i < x1; i++) {
    int dx = i - cx, dy = j - cy, d2 = dx * dx + dy * dy;
    if (d2 >= r2) continue;
    float t = 1.0f - sqrtf((float)d2) / r;
    px(i, j, c, (uint8_t)(maxA * t * t));
  }
}

// ---- gelapkan area dengan hitam (alpha a) secara cepat: k = 32 * (255 - a) / 255 ----
static inline void dimSpan(u16* p, int n, uint32_t k) {
  for (int i = 0; i < n; i++) {
    uint32_t v = p[i];
    v = (v | (v << 16)) & 0x07E0F81FUL;
    v = ((v * k) >> 5) & 0x07E0F81FUL;
    p[i] = (u16)(v | (v >> 16));
  }
}
static void dimRows(int y0, int y1, uint8_t a) {
  if (y0 < 0) y0 = 0; if (y1 > SCR_H) y1 = SCR_H;
  if (a == 0 || y0 >= y1) return;
  uint32_t k = (uint32_t)(255 - a) * 32 / 255;
  for (int y = y0; y < y1; y++) dimSpan(fb + y * SCR_W, SCR_W, k);
}

// ---- tempel cuplikan layar penuh (240x320) yang diskala ke kotak [X0,X1) x [Y0,Y1) dengan sudut membulat ----
static void blitScaled(const u16* src, int X0, int Y0, int X1, int Y1, int rad, uint8_t alpha) {
  int W = X1 - X0, Hh = Y1 - Y0;
  if (W < 2 || Hh < 2 || alpha == 0) return;
  static int16_t xmap[SCR_W];
  int cx0 = X0 < 0 ? 0 : X0, cx1 = X1 > SCR_W ? SCR_W : X1;
  int cy0 = Y0 < 0 ? 0 : Y0, cy1 = Y1 > SCR_H ? SCR_H : Y1;
  if (cx0 >= cx1 || cy0 >= cy1) return;
  for (int x = cx0; x < cx1; x++) xmap[x] = (int16_t)(((int32_t)(x - X0) * SCR_W) / W);
  if (rad > W / 2) rad = W / 2;
  if (rad > Hh / 2) rad = Hh / 2;
  for (int y = cy0; y < cy1; y++) {
    int sy = (int)(((int32_t)(y - Y0) * SCR_H) / Hh);
    const u16* srow = src + sy * SCR_W;
    u16* drow = fb + y * SCR_W;
    int xa = cx0, xb = cx1;
    if (rad > 0) {
      int dy = (y - Y0 < rad) ? rad - (y - Y0) : ((Y1 - 1 - y < rad) ? rad - (Y1 - 1 - y) : 0);
      if (dy > 0) {
        int inset = rad - (int)sqrtf((float)(rad * rad - dy * dy));
        if (xa < X0 + inset) xa = X0 + inset;
        if (xb > X1 - inset) xb = X1 - inset;
      }
    }
    if (alpha == 255) { for (int x = xa; x < xb; x++) drow[x] = srow[xmap[x]]; }
    else              { for (int x = xa; x < xb; x++) drow[x] = mix(srow[xmap[x]], drow[x], alpha); }
  }
}

// ---- teks (font 4-bit anti-alias). align: 0 kiri, 1 tengah, 2 kanan
static int charAdv16(const AFont& f, uint8_t ch) { if (ch < f.first || ch > f.last) return 0; return f.g[ch - f.first].adv; }
static int textWidth(const AFont& f, const char* s) {
  int pen = 0;
  for (; *s; s++) pen += charAdv16(f, (uint8_t)*s);
  return (pen + 8) >> 4;
}
static void blit4(const uint8_t* d, int w, int h, int x, int y, u16 c, uint8_t alpha) {
  if (x >= SCR_W || y >= SCR_H || x + w <= 0 || y + h <= 0) return;
  int idx = 0;
  for (int j = 0; j < h; j++) {
    for (int i = 0; i < w; i++, idx++) {
      uint8_t b = d[idx >> 1];
      uint8_t n = (idx & 1) ? (b & 0x0F) : (b >> 4);
      if (!n) continue;
      px(x + i, y + j, c, (uint8_t)((n * 17 * alpha) / 255));
    }
  }
}
static int drawText(const AFont& f, int x, int base, const char* s, u16 c, uint8_t alpha = 255, int align = 0) {
  int tw = textWidth(f, s);
  if (align == 1) x -= tw / 2; else if (align == 2) x -= tw;
  int pen = 0;
  for (const char* p = s; *p; p++) {
    uint8_t ch = (uint8_t)*p; if (ch < f.first || ch > f.last) continue;
    const AGlyph& g = f.g[ch - f.first];
    if (g.w) blit4(f.bmp + g.off, g.w, g.h, x + ((pen + 8) >> 4) + g.xo, base + g.yo, c, alpha);
    pen += g.adv;
  }
  return tw;
}
static void drawIcon(const AIcon& ic, float cx, float cy, u16 c, uint8_t alpha = 255) {
  blit4(ic.d, ic.w, ic.h, (int)floorf(cx - ic.w * 0.5f + 0.5f), (int)floorf(cy - ic.h * 0.5f + 0.5f), c, alpha);
}

static void fitText(const AFont& f, const char* str, int maxw, char* out, int outsz) {
  strncpy(out, str, outsz - 1); out[outsz - 1] = 0;
  if (textWidth(f, out) <= maxw) return;
  int n = (int)strlen(out);
  while (n > 0 && textWidth(f, out) + textWidth(f, "..") > maxw) out[--n] = 0;
  snprintf(out + n, outsz - n, "..");
}
// pecah teks menjadi baris (word wrap). Mengembalikan jumlah baris.
static int wrapLines(const AFont& f, int width, const char* text, const char** st, int* ln, int maxL) {
  int n = 0; const char* p = text;
  while (*p && n < maxL) {
    int w = 0; const char* q = p; const char* lastSp = nullptr;
    while (*q && *q != '\n') {
      int a = charAdv16(f, (uint8_t)*q);
      if (((w + a + 8) >> 4) > width) break;
      if (*q == ' ') lastSp = q;
      w += a; q++;
    }
    const char* end = q;
    if (*q && *q != '\n' && lastSp && lastSp > p) end = lastSp;
    if (end == p && *q && *q != '\n') end = p + 1;
    st[n] = p; ln[n] = (int)(end - p); n++;
    p = end; if (*p == '\n' || *p == ' ') p++;
  }
  return n;
}
static void drawLines(const AFont& f, int x, int base, int lineH, const char** st, int* ln, int from, int to, u16 c) {
  char buf[80];
  for (int i = from; i < to; i++) {
    int n = ln[i]; if (n > 79) n = 79;
    memcpy(buf, st[i], n); buf[n] = 0;
    drawText(f, x, base + (i - from) * lineH, buf, c);
  }
}

